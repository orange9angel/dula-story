  "lines": [
    {
      "id": "entry_3",
      "entry": 3,
      "character": "LeiXiao",
      "text": "这道印子……你能让它消失吗？",
      "start": 6.7,
      "end": 11.2,
      "audioEnd": 11.011541666666666,
      "duration": 4.311541666666667,
      "tempo": 1.03,
      "raw_sha256": "29ebbb36a7b73e58c29444271acd8d6fde35942de5023f81edc417493f5ca5de",
      "processed": "assets3d/processed/entry_3.wav",
      "processed_sha256": "2dec350fa4844fc41de6a521b29dbb6910f580bb343de8f39ea68cab4e391528"
    },
    {
      "id": "entry_4",
      "entry": 4,
      "character": "QianTangKui",
      "text": "先给我看。藏着那只。",
      "start": 11.899999999999999,
      "end": 14.5,
      "audioEnd": 13.627624999999998,
      "duration": 1.727625,
      "tempo": 1.06,
      "raw_sha256": "6014e63f5e0096ff25155596f79707d237e85a80e0d0eb6c813fcdf961f72aa0",
      "processed": "assets3d/processed/entry_4.wav",
      "processed_sha256": "6b39d139ed1f50ca835505435b8bb1cd6b2413c2a4f3c193f8300361873b86df"
    },
    {
      "id": "entry_5",
      "entry": 5,
      "character": "LeiXiao",
      "text": "你先保证，不把我泡进罐子里。",
      "start": 15.2,
      "end": 19.7,
      "audioEnd": 18.773625,
      "duration": 3.573625,
      "tempo": 1.02,
      "raw_sha256": "e1e94e7df1266a58aa5711b57f7e5dbaf853c7b1587413e9b8dcf03a58859911",
      "processed": "assets3d/processed/entry_5.wav",
      "processed_sha256": "43c9143fd90290fb8b8adfd9b20a201e2d35649f633a1f0eb82242b044eefadc"
    },
    {
      "id": "entry_6",
      "entry": 6,
      "character": "QianTangKui",
      "text": "装叶子的。你这么大，放不下。",
      "start": 20.4,
      "end": 24,
      "audioEnd": 22.65158333333333,
      "duration": 2.2515833333333335,
      "tempo": 1.05,
      "raw_sha256": "4bdf98dc0b586b7fff2ffa79f4bc298c5e3dc3598fdb8b80408bcf9ea99dd548",
      "processed": "assets3d/processed/entry_6.wav",
      "processed_sha256": "c6bc38db957be0fbb069d551a28e16ed7e2702bc87cab8bf158d4790ebcb1051"
    },
    {
      "id": "entry_7",
      "entry": 7,
      "character": "LeiXiao",
      "text": "擦不掉……那我把它收回去呢？",
      "start": 24.7,
      "end": 28.7,
      "audioEnd": 28.579395833333333,
      "duration": 3.879395833333333,
      "tempo": 1.08,
      "raw_sha256": "7fba4dd70f663845eda52c4907c9d7c3abdf15704445e1e338773438ee502123",
      "processed": "assets3d/processed/entry_7.wav",
      "processed_sha256": "499c37f0227b7115b08b707835fc78192d8fa4f374f3a1f07d34bb71e9ceed91"
    },
    {
      "id": "entry_8",
      "entry": 8,
      "character": "QianTangKui",
      "text": "先松手，别用力。",
      "start": 29.2,
      "end": 31.5,
      "audioEnd": 30.5879375,
      "duration": 1.3879375,
      "tempo": 1.08,
      "raw_sha256": "0587b3f467b029c2fe8f85ff1bc1422634ab8eb3d585d58f2f7f7594d5e71161",
      "processed": "assets3d/processed/entry_8.wav",
      "processed_sha256": "3c876bdbd147f98639830f31807327521774b69b0b085fe3dd0fc7dc80925ae6"
    },
    {
      "id": "entry_9",
      "entry": 9,
      "character": "LeiXiao",
      "text": "就一下——怎么还长了？",
      "start": 32.2,
      "end": 35.5,
      "audioEnd": 35.20075,
      "duration": 3.00075,
      "tempo": 1.08,
      "raw_sha256": "1de5a338e20b6c79ee1da169dd08ceb5d2623504e1e8518cd4cff09a5e85bb99",
      "processed": "assets3d/processed/entry_9.wav",
      "processed_sha256": "4ec3a308ddb41aa7031b9d2e8c0efcd28bc719bd608a82f09b67449b4f258207"
    },
    {
      "id": "entry_10",
      "entry": 10,
      "character": "QianTangKui",
      "text": "停。新长的那截，留下了。",
      "start": 36.2,
      "end": 40.7,
      "audioEnd": 38.5716875,
      "duration": 2.3716875,
      "tempo": 1.03,
      "raw_sha256": "b3e625fb4a699015cd1d764872db7dfef05f55f4e2d4644669446af9675428e7",
      "processed": "assets3d/processed/entry_10.wav",
      "processed_sha256": "d982afbc114e2bd0004ae4ad61a3e7d47d643a22c364eaab98e2f35c86c9436c"
    },
    {
      "id": "entry_11",
      "entry": 11,
      "character": "LeiXiao",
      "text": "那我一直这样？",
      "start": 41.400000000000006,
      "end": 44.2,
      "audioEnd": 43.21541666666667,
      "duration": 1.8154166666666667,
      "tempo": 1.01,
      "raw_sha256": "096de5b59661984bf533cf74a8482c76ea0254792e15fc7c6524427ef42a01c5",
      "processed": "assets3d/processed/entry_11.wav",
      "processed_sha256": "473701bc42f02cb626426452241ff0d838af0de08e3fa076910a5a5d743e39cf"
    },
    {
      "id": "entry_13",
      "entry": 13,
      "character": "QianTangKui",
      "text": "这叫蚀。我现在没办法让它消失。",
      "start": 48.2,
      "end": 53.2,
      "audioEnd": 51.23922916666667,
      "duration": 3.039229166666667,
      "tempo": 0.96,
      "raw_sha256": "5bc3fb794e864190679310cfc858af59d7018fa24b5eb080a1ef8de25b71387e",
      "processed": "assets3d/processed/entry_13.wav",
      "processed_sha256": "7086e811bca80f5e55135ee81e1de1f8ec96155d5aa1c456c3f498f07cbf396c"
    },
    {
      "id": "entry_14",
      "entry": 14,
      "character": "LeiXiao",
      "text": "……那明天再看。今天不试了。",
      "start": 53.900000000000006,
      "end": 57.7,
      "audioEnd": 57.468520833333336,
      "duration": 3.5685208333333334,
      "tempo": 1.02,
      "raw_sha256": "70d87e4241623484ed3f0ddec2ecdb503c1596dd030953d55b788b74a2b0274d",
      "processed": "assets3d/processed/entry_14.wav",
      "processed_sha256": "1a8d445889f941c2b7bdb39c9223659d0175006012028b60df7d50c8d4e76504"
    },
    {
      "id": "entry_15",
      "entry": 15,
      "character": "QianTangKui",
      "text": "帮我拿一下。这片叶子还没登记。",
      "start": 58.400000000000006,
      "end": 63.7,
      "audioEnd": 61.115750000000006,
      "duration": 2.71575,
      "tempo": 1.02,
      "raw_sha256": "5a4c9b8fcd16ce01c133b35d12470930de78dd2b59d65ecff864497d6f94d74e",
      "processed": "assets3d/processed/entry_15.wav",
      "processed_sha256": "15dee52cfb59f1a4314ad845eb1f4353f027b8c927ab74919df9521972a69c73"
    },
    {
      "id": "entry_16",
      "entry": 16,
      "character": "LeiXiao",
      "text": "我也得……贴个标签？",
      "start": 64.4,
      "end": 68.9,
      "audioEnd": 67.22025000000001,
      "duration": 2.82025,
      "tempo": 1.0,
      "raw_sha256": "bff9eb1be860df757190188c835159dcaac6cf9cb5800e5e2905abca509a4881",
      "processed": "assets3d/processed/entry_16.wav",
      "processed_sha256": "1f97bba20fa581406b1f0b3ac71799f85bd8506caf23c4280b7bcb989766acbe"
    },
    {
      "id": "entry_17",
      "entry": 17,
      "character": "QianTangKui",
      "text": "你不用。明天放学，自己来。",
      "start": 69.60000000000001,
      "end": 74.10000000000001,
      "audioEnd": 71.78095833333334,
      "duration": 2.1809583333333333,
      "tempo": 0.98,
      "raw_sha256": "5cdea627a00bba6943dddee23905e9e77c55b1f056037001d42253bb2def3218",
      "processed": "assets3d/processed/entry_17.wav",
      "processed_sha256": "e53d5693c5c638636b425c6f64e5658acfbf5693b19258e9bad6f8e53d6effe5"
    }
