  "lines": [
    {
      "id": "entry_3",
      "entry": 3,
      "character": "LeiXiao",
      "text": "我就问一下，这道印子……明天能消吗？",
      "start": 6,
      "end": 11.5,
      "audioEnd": 11.158229166666667,
      "duration": 5.158229166666667,
      "tempo": 1.05,
      "raw_sha256": "ae39a9f073bfb9c69c3e59ea80dd68c82b4fb0c1f00a3fad66ad1a088664f13e",
      "processed": "assets3d/processed/entry_3.wav",
      "processed_sha256": "0993d97bb01dc645209b49598470f37a438dc0d649d7bd3ecde6dcd58ff3df8e"
    },
    {
      "id": "entry_4",
      "entry": 4,
      "character": "QianTangKui",
      "text": "左手。右手那层，骗不了我。",
      "start": 12.2,
      "end": 16.099999999999998,
      "audioEnd": 15.740625,
      "duration": 3.540625,
      "tempo": 1.02,
      "raw_sha256": "793ec4dc23ea42fd0b92024e33c91f8f2bb3fd92689064bf5249030939bf1795",
      "processed": "assets3d/processed/entry_4.wav",
      "processed_sha256": "47d9eac87d12e5ac2aef4c02818970ed2316fe4215ef43982b4aaa8b1e082412"
    },
    {
      "id": "entry_5",
      "entry": 5,
      "character": "LeiXiao",
      "text": "你先保证，不把我泡进罐子里。",
      "start": 16.8,
      "end": 20.5,
      "audioEnd": 19.877208333333336,
      "duration": 3.0772083333333335,
      "tempo": 1.05,
      "raw_sha256": "86829b44ce7f2a433f8bf0d7b0e0204e0af38a7f492de3bf23d7e11d02c774ae",
      "processed": "assets3d/processed/entry_5.wav",
      "processed_sha256": "a5678516b499e7365c564881626d54daeb7c79e8b33c7344ffef83022395a29c"
    },
    {
      "id": "entry_6",
      "entry": 6,
      "character": "QianTangKui",
      "text": "罐子是装叶子的。你先别动。",
      "start": 21.2,
      "end": 25.5,
      "audioEnd": 23.721,
      "duration": 2.521,
      "tempo": 1.0,
      "raw_sha256": "d241e7affdfbb2470524a9dfaa4dc919a75c7df41685daf6274a654c2fe9c946",
      "processed": "assets3d/processed/entry_6.wav",
      "processed_sha256": "08f7924a8390e7725f6eb1b2f8bc16d304c44ab546d47b0401d0904ad6cca217"
    },
    {
      "id": "entry_7",
      "entry": 7,
      "character": "LeiXiao",
      "text": "我一想收回去，它怎么更长了？",
      "start": 26.2,
      "end": 29.5,
      "audioEnd": 29.280479166666666,
      "duration": 3.0804791666666667,
      "tempo": 1.05,
      "raw_sha256": "e4cba20c06561b7eaff73bcb5e891f92c5b68e4d070fd1583ff923d09914e395",
      "processed": "assets3d/processed/entry_7.wav",
      "processed_sha256": "f30854af39860975aabc3416959f5ab803c03c63507f5a6b045a2e0e8b2a911e"
    },
    {
      "id": "entry_8",
      "entry": 8,
      "character": "QianTangKui",
      "text": "别再催它。",
      "start": 30.2,
      "end": 32.5,
      "audioEnd": 31.483666666666664,
      "duration": 1.2836666666666667,
      "tempo": 1.0,
      "raw_sha256": "6aadc7f3dd3211986c0d4fddc1d177dfc6f63d4378fb0f3d6851488887df73c3",
      "processed": "assets3d/processed/entry_8.wav",
      "processed_sha256": "259a57e252a494ca8d068ca1a77a28671cb9a1c0bee4cae52eba473a02d1b4e7"
    },
    {
      "id": "entry_10",
      "entry": 10,
      "character": "LeiXiao",
      "text": "那我慢一点，就一下。",
      "start": 37.2,
      "end": 40.5,
      "audioEnd": 39.926625,
      "duration": 2.726625,
      "tempo": 1.04,
      "raw_sha256": "228faab9b9739a03ffabe989038155d86278ac21df4ef349f1345fac5173ba1a",
      "processed": "assets3d/processed/entry_10.wav",
      "processed_sha256": "78c07e430abf1841331e3a0c598bf146881627745d6af77507822cf41670ca9c"
    },
    {
      "id": "entry_11",
      "entry": 11,
      "character": "QianTangKui",
      "text": "停。你刚才催的那截，留下了。这叫蚀。",
      "start": 41.2,
      "end": 47.5,
      "audioEnd": 45.52216666666667,
      "duration": 4.322166666666667,
      "tempo": 1.02,
      "raw_sha256": "35aafd9894c2a00cf06f1bca8f781df32daaf9db920ebcc880a9e187d364c65b",
      "processed": "assets3d/processed/entry_11.wav",
      "processed_sha256": "93b2e98020eed5ddb5bdf13e53b6c76e6c6ae730e73f8fbcc2ff1db4a8d13ffc"
    },
    {
      "id": "entry_13",
      "entry": 13,
      "character": "LeiXiao",
      "text": "……明天看得见就看得见。今天不试了。",
      "start": 51.2,
      "end": 56.5,
      "audioEnd": 55.215583333333335,
      "duration": 4.015583333333334,
      "tempo": 1.0,
      "raw_sha256": "0b35c155e198593cdcb13dc74dc7342203e80eb02b87df8c5362d4aca9e369cc",
      "processed": "assets3d/processed/entry_13.wav",
      "processed_sha256": "5493a7876332c0617c9756a78718011fd8ba9eb6ccadb0e999463b47caf046a5"
    },
    {
      "id": "entry_14",
      "entry": 14,
      "character": "QianTangKui",
      "text": "明天放学，还站这儿。让我看看它有没有变。",
      "start": 57.2,
      "end": 63.5,
      "audioEnd": 61.20452083333333,
      "duration": 4.004520833333333,
      "tempo": 1.0,
      "raw_sha256": "cbeddde440f4ee3664c60adb588d0621724a03adc89a6bf05fb5fb5fef99a818",
      "processed": "assets3d/processed/entry_14.wav",
      "processed_sha256": "5fb701a868817912ab9d207c1803246bc87a83197886f3acdda25b89388458e9"
    },
    {
      "id": "entry_15",
      "entry": 15,
      "character": "LeiXiao",
      "text": "先说好，罐子得一直装叶子。",
      "start": 64.2,
      "end": 68.5,
      "audioEnd": 67.87547916666666,
      "duration": 3.675479166666667,
      "tempo": 1.05,
      "raw_sha256": "b26a2433e6555ad88c949e777e4c6cac22ec234ad6602a918470505e89c4251e",
      "processed": "assets3d/processed/entry_15.wav",
      "processed_sha256": "1758155fa8e78d5c9b7aee22929ef6afb3c5d229454db9f6e66a6927a3c7d8bf"
    },
    {
      "id": "entry_16",
      "entry": 16,
      "character": "QianTangKui",
      "text": "放心。你比叶子难养。",
      "start": 69.2,
      "end": 73.5,
      "audioEnd": 71.76254166666666,
      "duration": 2.5625416666666667,
      "tempo": 1.0,
      "raw_sha256": "5ba54ac96174dde7a6e491b81eae100e0da3a4434032eea375a258730e0354ec",
      "processed": "assets3d/processed/entry_16.wav",
      "processed_sha256": "a36126d1993b8304b22cb2693fd025d694975aeb7842139f8576f42e3c6fe865"
    }
