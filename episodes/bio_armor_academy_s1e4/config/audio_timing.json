  "lines": [
    {
      "id": "entry_3",
      "entry": 3,
      "character": "LeiXiao",
      "text": "这道印子……你能让它消失吗？",
      "start": 6.7,
      "end": 11.2,
      "audioEnd": 9.851291666666667,
      "duration": 3.151291666666667,
      "tempo": 1.0,
      "raw_sha256": "2a18dea07afe705ec5346cf408228eb6246ddf51ddc8c431c532a7605bd513ad",
      "processed": "assets3d/processed/entry_3.wav",
      "processed_sha256": "433f808bb60bd1bb3b8f36be831f4836de4d42f20297e4e9536afb7a9c796158"
    },
    {
      "id": "entry_4",
      "entry": 4,
      "character": "QianTangKui",
      "text": "先给我看。藏着那只。",
      "start": 11.899999999999999,
      "end": 14.5,
      "audioEnd": 14.054895833333331,
      "duration": 2.1548958333333332,
      "tempo": 1.0,
      "raw_sha256": "15e64af8d0c262d197d3e14d3d579d02d4e56952007e38e8b09430e0b9738680",
      "processed": "assets3d/processed/entry_4.wav",
      "processed_sha256": "5a3ad2d2541176fe5389858a09259fec79bcab1ba8d6a742e98b5b5d5824770f"
    },
    {
      "id": "entry_5",
      "entry": 5,
      "character": "LeiXiao",
      "text": "你先保证，不把我泡进罐子里。",
      "start": 15.2,
      "end": 19.7,
      "audioEnd": 17.591208333333334,
      "duration": 2.391208333333333,
      "tempo": 1.0,
      "raw_sha256": "8fad758fe334eca78b1861063d4bc481119cc9ed3c36ac35e9545b22d6db7e8a",
      "processed": "assets3d/processed/entry_5.wav",
      "processed_sha256": "151b338057af90e8b5afe3b8d73264aba270a735e82387b1257bc4ea46ac68c0"
    },
    {
      "id": "entry_6",
      "entry": 6,
      "character": "QianTangKui",
      "text": "装叶子的。你这么大，放不下。",
      "start": 20.4,
      "end": 24,
      "audioEnd": 22.745895833333332,
      "duration": 2.3458958333333335,
      "tempo": 1.0,
      "raw_sha256": "150022008cab93eba327d225f386c8187d9ff97c632fbafd87ac3ac6217ef4ea",
      "processed": "assets3d/processed/entry_6.wav",
      "processed_sha256": "c049eb1da3a032b78aab260a2a8ceb330b9c1e1cf50173013cbc77f43d63dcd0"
    },
    {
      "id": "entry_7",
      "entry": 7,
      "character": "LeiXiao",
      "text": "擦不掉……那我把它收回去呢？",
      "start": 24.7,
      "end": 28.7,
      "audioEnd": 27.575645833333333,
      "duration": 2.8756458333333335,
      "tempo": 1.0,
      "raw_sha256": "8327e3be112d29ec8a3cb7ba04f89346845084a1b9a07a407fe0ea56705aafff",
      "processed": "assets3d/processed/entry_7.wav",
      "processed_sha256": "b2bfd89577c24ed6487a3500b36d75da7e19c74129c77673df2c3a9ccc543647"
    },
    {
      "id": "entry_8",
      "entry": 8,
      "character": "QianTangKui",
      "text": "先松手，别用力。",
      "start": 29.2,
      "end": 31.5,
      "audioEnd": 30.671083333333332,
      "duration": 1.4710833333333333,
      "tempo": 1.0,
      "raw_sha256": "4341ef8cad810fe5f4b10c2d5eeb3de6f45cc6ecdf47bd903aff240438b78e5f",
      "processed": "assets3d/processed/entry_8.wav",
      "processed_sha256": "2b6f3c5ee7bcdc56ba0db186bc913638fc8edb5ed271d25965b2a90ebddb796e"
    },
    {
      "id": "entry_9",
      "entry": 9,
      "character": "LeiXiao",
      "text": "就一下——怎么还长了？",
      "start": 32.2,
      "end": 35.5,
      "audioEnd": 33.7755625,
      "duration": 1.5755625,
      "tempo": 1.0,
      "raw_sha256": "c2787720551ddd54b3a3efc2f76dd2e6c7b56122f67b80f58c5e78ca43a0c0b0",
      "processed": "assets3d/processed/entry_9.wav",
      "processed_sha256": "1c84aebf5bfcac4be37452c10f734e3f01af7044aee89ac2326cf8f34ae023e3"
    },
    {
      "id": "entry_10",
      "entry": 10,
      "character": "QianTangKui",
      "text": "停。新长的那截，留下了。",
      "start": 36.2,
      "end": 40.7,
      "audioEnd": 38.572229166666666,
      "duration": 2.3722291666666666,
      "tempo": 1.0,
      "raw_sha256": "21cfe44a1b8ed810a8867c3e9ac2c172f2a4c5b05987c968c738368cd7489a72",
      "processed": "assets3d/processed/entry_10.wav",
      "processed_sha256": "8dee1c797bec65b2d72f866595959ab7beda1b19f6f6978ef12517fd078a3ca1"
    },
    {
      "id": "entry_11",
      "entry": 11,
      "character": "LeiXiao",
      "text": "那我一直这样？",
      "start": 41.400000000000006,
      "end": 44.2,
      "audioEnd": 42.6134375,
      "duration": 1.2134375,
      "tempo": 1.0,
      "raw_sha256": "beb4ec834d77ec3b16c664cf9398b977278ad6143877ce2a5bfcbf49a29df86c",
      "processed": "assets3d/processed/entry_11.wav",
      "processed_sha256": "c1595e009dbeb08e607d064567f09e5fce08e58796869b3e5fd44b2a5807180a"
    },
    {
      "id": "entry_13",
      "entry": 13,
      "character": "QianTangKui",
      "text": "这叫蚀。我现在没办法让它消失。",
      "start": 48.2,
      "end": 53.2,
      "audioEnd": 51.244125000000004,
      "duration": 3.044125,
      "tempo": 1.0,
      "raw_sha256": "72268dda15893d3f140318084b53575c48e2251a5a82c37594c8e2d19006b20e",
      "processed": "assets3d/processed/entry_13.wav",
      "processed_sha256": "92284674527f5037114be10c5c36b26bc700157d4fe65073ee5edbab4f926e81"
    },
    {
      "id": "entry_14",
      "entry": 14,
      "character": "LeiXiao",
      "text": "……那明天再看。今天不试了。",
      "start": 53.900000000000006,
      "end": 57.7,
      "audioEnd": 56.48189583333334,
      "duration": 2.5818958333333333,
      "tempo": 1.0,
      "raw_sha256": "a8e7a9926b70b10cf07c60206c127b3b6c4376b47c082330a66eaa54117fe078",
      "processed": "assets3d/processed/entry_14.wav",
      "processed_sha256": "5d63d7d27d3c0a087b1a80a3b166d97afb4506ed55c9fa28d9f9946b981693fa"
    },
    {
      "id": "entry_15",
      "entry": 15,
      "character": "QianTangKui",
      "text": "帮我拿一下。这片叶子还没登记。",
      "start": 58.400000000000006,
      "end": 63.7,
      "audioEnd": 61.10631250000001,
      "duration": 2.7063125,
      "tempo": 1.0,
      "raw_sha256": "5c17fff510d87d83baf75550f7c5b443ae39d619628e0e7b0dd76a4a52149102",
      "processed": "assets3d/processed/entry_15.wav",
      "processed_sha256": "1075f707b478aaa416547ae6f88d32d610a8f3f726be49ab05be8783e3a6d42c"
    },
    {
      "id": "entry_16",
      "entry": 16,
      "character": "LeiXiao",
      "text": "我也得……贴个标签？",
      "start": 64.4,
      "end": 68.9,
      "audioEnd": 66.59777083333334,
      "duration": 2.1977708333333332,
      "tempo": 1.0,
      "raw_sha256": "d2c0fde7c66f6fb33eaa717524220ba2ab090a7160a2a4e695dc512ae689ce99",
      "processed": "assets3d/processed/entry_16.wav",
      "processed_sha256": "d7dcf5008f40808874236a3822b61779d811e013b5c2a8298f5a53c80b356eed"
    },
    {
      "id": "entry_17",
      "entry": 17,
      "character": "QianTangKui",
      "text": "你不用。明天放学，自己来。",
      "start": 69.60000000000001,
      "end": 74.10000000000001,
      "audioEnd": 71.98158333333335,
      "duration": 2.3815833333333334,
      "tempo": 1.0,
      "raw_sha256": "bc4622572cef0ddcfda098bd6fadce1df86aac453cb94772042bac3f521cb0e3",
      "processed": "assets3d/processed/entry_17.wav",
      "processed_sha256": "0a3e83894955d15ee851e5523a32b8456db1e3ad1c62c8178a2973a639734ca8"
    }
