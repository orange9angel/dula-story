  "lines": [
    {
      "id": "entry_3",
      "entry": 3,
      "character": "LeiXiao",
      "text": "这道印子……你能让它消失吗？",
      "start": 6.7,
      "end": 11.2,
      "audioEnd": 9.851291666666667,
      "duration": 3.151291666666667,
      "tempo": 1.0,
      "raw_sha256": "2a18dea07afe705ec5346cf408228eb6246ddf51ddc8c431c532a7605bd513ad",
      "processed": "assets3d/processed/entry_3.wav",
      "processed_sha256": "433f808bb60bd1bb3b8f36be831f4836de4d42f20297e4e9536afb7a9c796158"
    },
    {
      "id": "entry_4",
      "entry": 4,
      "character": "QianTangKui",
      "text": "先给我看。藏着那只。",
      "start": 11.899999999999999,
      "end": 14.5,
      "audioEnd": 13.954666666666665,
      "duration": 2.054666666666667,
      "tempo": 1.0,
      "raw_sha256": "376753706e6263af087860696259d7ed80a6fd4a17f0ff34e50d0a657eb41697",
      "processed": "assets3d/processed/entry_4.wav",
      "processed_sha256": "a728eb1d5635dcd556ef98cda4b5efd23aa1482631b506d7a6a98d3b95328e2b"
    },
    {
      "id": "entry_5",
      "entry": 5,
      "character": "LeiXiao",
      "text": "你先保证，不把我泡进罐子里。",
      "start": 15.2,
      "end": 19.7,
      "audioEnd": 17.591208333333334,
      "duration": 2.391208333333333,
      "tempo": 1.0,
      "raw_sha256": "8fad758fe334eca78b1861063d4bc481119cc9ed3c36ac35e9545b22d6db7e8a",
      "processed": "assets3d/processed/entry_5.wav",
      "processed_sha256": "151b338057af90e8b5afe3b8d73264aba270a735e82387b1257bc4ea46ac68c0"
    },
    {
      "id": "entry_6",
      "entry": 6,
      "character": "QianTangKui",
      "text": "装叶子的。你这么大，放不下。",
      "start": 20.4,
      "end": 24,
      "audioEnd": 22.797791666666665,
      "duration": 2.3977916666666665,
      "tempo": 1.0,
      "raw_sha256": "d84042a27d8c4ef9aa01e8bd9236730946eea973d195d240f615f127fc8e5db5",
      "processed": "assets3d/processed/entry_6.wav",
      "processed_sha256": "b4dbf8cb6f7eb716105faa7777c17d038cc8d384ababf080390dfe59c8a75282"
    },
    {
      "id": "entry_7",
      "entry": 7,
      "character": "LeiXiao",
      "text": "擦不掉……那我把它收回去呢？",
      "start": 24.7,
      "end": 28.7,
      "audioEnd": 27.575645833333333,
      "duration": 2.8756458333333335,
      "tempo": 1.0,
      "raw_sha256": "8327e3be112d29ec8a3cb7ba04f89346845084a1b9a07a407fe0ea56705aafff",
      "processed": "assets3d/processed/entry_7.wav",
      "processed_sha256": "b2bfd89577c24ed6487a3500b36d75da7e19c74129c77673df2c3a9ccc543647"
    },
    {
      "id": "entry_8",
      "entry": 8,
      "character": "QianTangKui",
      "text": "先松手，别用力。",
      "start": 29.2,
      "end": 31.5,
      "audioEnd": 30.803645833333334,
      "duration": 1.6036458333333334,
      "tempo": 1.0,
      "raw_sha256": "7bc4f7e904c13b538d45666906c44c328061b49eae1141c67dfb25547570e758",
      "processed": "assets3d/processed/entry_8.wav",
      "processed_sha256": "c155f817b3f83a2d1102c46663b7e51bec1a1edb44e961bb7f7107a31632e91a"
    },
    {
      "id": "entry_9",
      "entry": 9,
      "character": "LeiXiao",
      "text": "就一下——怎么还长了？",
      "start": 32.2,
      "end": 35.5,
      "audioEnd": 33.7755625,
      "duration": 1.5755625,
      "tempo": 1.0,
      "raw_sha256": "c2787720551ddd54b3a3efc2f76dd2e6c7b56122f67b80f58c5e78ca43a0c0b0",
      "processed": "assets3d/processed/entry_9.wav",
      "processed_sha256": "1c84aebf5bfcac4be37452c10f734e3f01af7044aee89ac2326cf8f34ae023e3"
    },
    {
      "id": "entry_10",
      "entry": 10,
      "character": "QianTangKui",
      "text": "停。新长的那截，留下了。",
      "start": 36.2,
      "end": 40.7,
      "audioEnd": 38.533166666666666,
      "duration": 2.3331666666666666,
      "tempo": 1.0,
      "raw_sha256": "66f56ccc003603a3de674641376c98b7e7b87a5f73f6543d5a9a5e9f9946fda0",
      "processed": "assets3d/processed/entry_10.wav",
      "processed_sha256": "7cc8a8ef4c9ec1c283eb2630c797002b34232ef4745b4c6f53b35caaeb73f974"
    },
    {
      "id": "entry_11",
      "entry": 11,
      "character": "LeiXiao",
      "text": "那我一直这样？",
      "start": 41.400000000000006,
      "end": 44.2,
      "audioEnd": 42.6134375,
      "duration": 1.2134375,
      "tempo": 1.0,
      "raw_sha256": "beb4ec834d77ec3b16c664cf9398b977278ad6143877ce2a5bfcbf49a29df86c",
      "processed": "assets3d/processed/entry_11.wav",
      "processed_sha256": "c1595e009dbeb08e607d064567f09e5fce08e58796869b3e5fd44b2a5807180a"
    },
    {
      "id": "entry_13",
      "entry": 13,
      "character": "QianTangKui",
      "text": "这叫蚀。我现在没办法让它消失。",
      "start": 48.2,
      "end": 53.2,
      "audioEnd": 51.489312500000004,
      "duration": 3.2893125,
      "tempo": 1.0,
      "raw_sha256": "4578250e4e417ac125f95b37028e28f08373fe8c567cc71d4f066367b15e4f31",
      "processed": "assets3d/processed/entry_13.wav",
      "processed_sha256": "4522c208b45c49c33cc9f5e63287f640aed018936ba8953981a0445caff75fad"
    },
    {
      "id": "entry_14",
      "entry": 14,
      "character": "LeiXiao",
      "text": "……那明天再看。今天不试了。",
      "start": 53.900000000000006,
      "end": 57.7,
      "audioEnd": 56.48189583333334,
      "duration": 2.5818958333333333,
      "tempo": 1.0,
      "raw_sha256": "a8e7a9926b70b10cf07c60206c127b3b6c4376b47c082330a66eaa54117fe078",
      "processed": "assets3d/processed/entry_14.wav",
      "processed_sha256": "5d63d7d27d3c0a087b1a80a3b166d97afb4506ed55c9fa28d9f9946b981693fa"
    },
    {
      "id": "entry_15",
      "entry": 15,
      "character": "QianTangKui",
      "text": "帮我拿一下。这片叶子还没登记。",
      "start": 58.400000000000006,
      "end": 63.7,
      "audioEnd": 61.25747916666667,
      "duration": 2.857479166666667,
      "tempo": 1.0,
      "raw_sha256": "6a0cc2467f563837d0175cb1f7c8530201cac5de709be4da81501be167a8f577",
      "processed": "assets3d/processed/entry_15.wav",
      "processed_sha256": "aaac31acbe2f82a9b26d35274805ba23826c6b53284d10869ee06b2c26a7a439"
    },
    {
      "id": "entry_16",
      "entry": 16,
      "character": "LeiXiao",
      "text": "我也得……贴个标签？",
      "start": 64.4,
      "end": 68.9,
      "audioEnd": 66.59777083333334,
      "duration": 2.1977708333333332,
      "tempo": 1.0,
      "raw_sha256": "d2c0fde7c66f6fb33eaa717524220ba2ab090a7160a2a4e695dc512ae689ce99",
      "processed": "assets3d/processed/entry_16.wav",
      "processed_sha256": "d7dcf5008f40808874236a3822b61779d811e013b5c2a8298f5a53c80b356eed"
    },
    {
      "id": "entry_17",
      "entry": 17,
      "character": "QianTangKui",
      "text": "你不用。明天放学，自己来。",
      "start": 69.60000000000001,
      "end": 74.10000000000001,
      "audioEnd": 72.15287500000001,
      "duration": 2.552875,
      "tempo": 1.0,
      "raw_sha256": "20eb9b0c1e507e8aabfc7e5b94ddbae9a6328a9c967ac54b1de0d08bd6b9f505",
      "processed": "assets3d/processed/entry_17.wav",
      "processed_sha256": "5aeb2b7d450dc8f1ac67e69f31ae5f5a1202eae36512ada256c715481aaecf00"
    }
  ],
