  "lines": [
    {
      "id": "entry_3",
      "entry": 3,
      "character": "LeiXiao",
      "text": "这道印子……你能让它消失吗？",
      "start": 6.7,
      "end": 11.2,
      "audioEnd": 10.668104166666666,
      "duration": 3.9681041666666665,
      "tempo": 1.0,
      "raw_sha256": "c2e2a45d1041daf6de92a227d4155aade7b6505934e47c7ebabd655b7d3c027b",
      "processed": "assets3d/processed/entry_3.wav",
      "processed_sha256": "e260b375ebd63c2d6d8a0d8692d9e07d44ae6266b179117de5c68f5fe8d66e19"
    },
    {
      "id": "entry_4",
      "entry": 4,
      "character": "QianTangKui",
      "text": "先给我看。藏着那只。",
      "start": 11.899999999999999,
      "end": 14.5,
      "audioEnd": 13.627624999999998,
      "duration": 1.727625,
      "tempo": 1.06,
      "raw_sha256": "6014e63f5e0096ff25155596f79707d237e85a80e0d0eb6c813fcdf961f72aa0",
      "processed": "assets3d/processed/entry_4.wav",
      "processed_sha256": "6b39d139ed1f50ca835505435b8bb1cd6b2413c2a4f3c193f8300361873b86df"
    },
    {
      "id": "entry_5",
      "entry": 5,
      "character": "LeiXiao",
      "text": "你先保证，不把我泡进罐子里。",
      "start": 15.2,
      "end": 19.7,
      "audioEnd": 18.4104375,
      "duration": 3.2104375,
      "tempo": 1.0,
      "raw_sha256": "af33af56d13466ceb2bb812105ad134b64376c06c6ac5883adad1975d13ee680",
      "processed": "assets3d/processed/entry_5.wav",
      "processed_sha256": "ed43241b86dd75a0ec52e641ae2c373662b9cffc9ed29a5d5f1df256296c316a"
    },
    {
      "id": "entry_6",
      "entry": 6,
      "character": "QianTangKui",
      "text": "装叶子的。你这么大，放不下。",
      "start": 20.4,
      "end": 24,
      "audioEnd": 22.65158333333333,
      "duration": 2.2515833333333335,
      "tempo": 1.05,
      "raw_sha256": "4bdf98dc0b586b7fff2ffa79f4bc298c5e3dc3598fdb8b80408bcf9ea99dd548",
      "processed": "assets3d/processed/entry_6.wav",
      "processed_sha256": "c6bc38db957be0fbb069d551a28e16ed7e2702bc87cab8bf158d4790ebcb1051"
    },
    {
      "id": "entry_7",
      "entry": 7,
      "character": "LeiXiao",
      "text": "擦不掉……那我把它收回去呢？",
      "start": 24.7,
      "end": 28.7,
      "audioEnd": 28.317979166666667,
      "duration": 3.6179791666666667,
      "tempo": 1.0,
      "raw_sha256": "3a6ecdea88b0c8797b9c0957147952221e6276ee57e7ccba74c2b537ef8b288a",
      "processed": "assets3d/processed/entry_7.wav",
      "processed_sha256": "38cf17b874981b96bf3b50d77a96d639910f48bb1a8e5db9bcaee254b023702e"
    },
    {
      "id": "entry_8",
      "entry": 8,
      "character": "QianTangKui",
      "text": "先松手，别用力。",
      "start": 29.2,
      "end": 31.5,
      "audioEnd": 30.5879375,
      "duration": 1.3879375,
      "tempo": 1.08,
      "raw_sha256": "0587b3f467b029c2fe8f85ff1bc1422634ab8eb3d585d58f2f7f7594d5e71161",
      "processed": "assets3d/processed/entry_8.wav",
      "processed_sha256": "3c876bdbd147f98639830f31807327521774b69b0b085fe3dd0fc7dc80925ae6"
    },
    {
      "id": "entry_9",
      "entry": 9,
      "character": "LeiXiao",
      "text": "就一下——怎么还长了？",
      "start": 32.2,
      "end": 35.5,
      "audioEnd": 35.424062500000005,
      "duration": 3.2240625,
      "tempo": 1.0,
      "raw_sha256": "93e62a87859b52c77d8f99b01715bc60c8fd9f75011f8309cb5d3cc57d5b9455",
      "processed": "assets3d/processed/entry_9.wav",
      "processed_sha256": "c4930b4ddb4e0b459a81cad2281407aa67554e4327d7e835f8542f867966f1d6"
    },
    {
      "id": "entry_10",
      "entry": 10,
      "character": "QianTangKui",
      "text": "停。新长的那截，留下了。",
      "start": 36.2,
      "end": 40.7,
      "audioEnd": 38.5716875,
      "duration": 2.3716875,
      "tempo": 1.03,
      "raw_sha256": "b3e625fb4a699015cd1d764872db7dfef05f55f4e2d4644669446af9675428e7",
      "processed": "assets3d/processed/entry_10.wav",
      "processed_sha256": "d982afbc114e2bd0004ae4ad61a3e7d47d643a22c364eaab98e2f35c86c9436c"
    },
    {
      "id": "entry_11",
      "entry": 11,
      "character": "LeiXiao",
      "text": "那我一直这样？",
      "start": 41.400000000000006,
      "end": 44.2,
      "audioEnd": 43.25289583333334,
      "duration": 1.8528958333333334,
      "tempo": 1.0,
      "raw_sha256": "4a844306ee4221e8cdc4fb7ae34d36a3bfb0cd4d85b03a3a77df2b78db5d6210",
      "processed": "assets3d/processed/entry_11.wav",
      "processed_sha256": "49983a429d2739e1419cd9c94801bfb697d2d06ed35517ed0347cee504dca55a"
    },
    {
      "id": "entry_13",
      "entry": 13,
      "character": "QianTangKui",
      "text": "这叫蚀。我现在没办法让它消失。",
      "start": 48.2,
      "end": 53.2,
      "audioEnd": 51.23922916666667,
      "duration": 3.039229166666667,
      "tempo": 0.96,
      "raw_sha256": "5bc3fb794e864190679310cfc858af59d7018fa24b5eb080a1ef8de25b71387e",
      "processed": "assets3d/processed/entry_13.wav",
      "processed_sha256": "7086e811bca80f5e55135ee81e1de1f8ec96155d5aa1c456c3f498f07cbf396c"
    },
    {
      "id": "entry_14",
      "entry": 14,
      "character": "LeiXiao",
      "text": "……那明天再看。今天不试了。",
      "start": 53.900000000000006,
      "end": 57.7,
      "audioEnd": 57.695083333333336,
      "duration": 3.7950833333333334,
      "tempo": 1.0,
      "raw_sha256": "46c71a9bbe690c161986caa09bed8a528b4bd3589c55a25c8363570b57313eb9",
      "processed": "assets3d/processed/entry_14.wav",
      "processed_sha256": "c3d2c666e47a9fbb186c7fd5314cc176cfa21a5c27cda30cacba59413c29bd40"
    },
    {
      "id": "entry_15",
      "entry": 15,
      "character": "QianTangKui",
      "text": "帮我拿一下。这片叶子还没登记。",
      "start": 58.400000000000006,
      "end": 63.7,
      "audioEnd": 61.115750000000006,
      "duration": 2.71575,
      "tempo": 1.02,
      "raw_sha256": "5a4c9b8fcd16ce01c133b35d12470930de78dd2b59d65ecff864497d6f94d74e",
      "processed": "assets3d/processed/entry_15.wav",
      "processed_sha256": "15dee52cfb59f1a4314ad845eb1f4353f027b8c927ab74919df9521972a69c73"
    },
    {
      "id": "entry_16",
      "entry": 16,
      "character": "LeiXiao",
      "text": "我也得……贴个标签？",
      "start": 64.4,
      "end": 68.9,
      "audioEnd": 67.42681250000001,
      "duration": 3.0268125,
      "tempo": 1.0,
      "raw_sha256": "8849dff6de20f7be488b6d8fc0ecc64d8a18b11595397a7a99865465f8a62f07",
      "processed": "assets3d/processed/entry_16.wav",
      "processed_sha256": "7ee473a419e823682ccf773be5c3825c92e8cf2cfe67d9b72e80d1a9a2a74f38"
    },
    {
      "id": "entry_17",
      "entry": 17,
      "character": "QianTangKui",
      "text": "你不用。明天放学，自己来。",
      "start": 69.60000000000001,
      "end": 74.10000000000001,
      "audioEnd": 71.78095833333334,
      "duration": 2.1809583333333333,
      "tempo": 0.98,
      "raw_sha256": "5cdea627a00bba6943dddee23905e9e77c55b1f056037001d42253bb2def3218",
      "processed": "assets3d/processed/entry_17.wav",
      "processed_sha256": "e53d5693c5c638636b425c6f64e5658acfbf5693b19258e9bad6f8e53d6effe5"
    }
