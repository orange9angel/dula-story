  "dialogue": [
    {
      "entry": 3,
      "character": "LeiXiao",
      "text": "这道印子……你能让它消失吗？",
      "startTime": 6.5,
      "endTime": 11.5,
      "speechWindow": [
        6.7,
        11.2
      ],
      "scene": "BiologyRoomScene",
      "shotIds": [
        "entry_3"
      ],
      "previousEntry": null,
      "nextEntry": 4,
      "intent": "带着信任向她求助",
      "subtext": "想靠近她，也相信她有办法",
      "delivery": {
        "tone": "warm_engaged",
        "nativeEmotion": null,
        "nativeEmotionScale": null,
        "energy": 0.53,
        "pace": 1.0,
        "volume": 0.96,
        "pitchSemitones": 0,
        "emphasis": "normal",
        "distance": "near",
        "space": "quiet biology room",
        "pauseBeforeMs": 0,
        "pauseAfterMs": 0,
        "breath": "natural",
        "nativeContextTexts": [
          "阳光开朗的少年，正开心地和喜欢的女同学聊天。声音明亮，有明显笑意，语调活泼，亲切自然。有精神地向她求助，带好奇和信任，像终于找到能帮自己的同学。"
        ],
        "nativeSpeechRate": 5
      }
    },
    {
      "entry": 4,
      "character": "QianTangKui",
      "text": "先给我看。藏着那只。",
      "startTime": 11.7,
      "endTime": 14.8,
      "speechWindow": [
        11.899999999999999,
        14.5
      ],
      "scene": "BiologyRoomScene",
      "shotIds": [
        "entry_4"
      ],
      "previousEntry": 3,
      "nextEntry": 5,
      "intent": "让他坦白展示受伤的手",
      "subtext": "已经注意到你的遮掩",
      "delivery": {
        "tone": "casual_request",
        "nativeEmotion": null,
        "nativeEmotionScale": null,
        "energy": 0.38,
        "pace": 1.0,
        "volume": 0.92,
        "pitchSemitones": 0,
        "emphasis": "normal",
        "distance": "medium",
        "space": "quiet biology room",
        "pauseBeforeMs": 0,
        "pauseAfterMs": 0,
        "breath": "natural",
        "nativeContextTexts": [
          "同学一边求助一边把手藏着，你已经看到了，随口让他把那只手伸出来，亲近自然。"
        ],
        "nativeSpeechRate": 0
      }
    },
    {
      "entry": 5,
      "character": "LeiXiao",
      "text": "你先保证，不把我泡进罐子里。",
      "startTime": 15,
      "endTime": 20,
      "speechWindow": [
        15.2,
        19.7
      ],
      "scene": "BiologyRoomScene",
      "shotIds": [
        "entry_5"
      ],
      "previousEntry": 4,
      "nextEntry": 6,
      "intent": "逗她笑，接住她的直接",
      "subtext": "跟她待在一起很自在",
      "delivery": {
        "tone": "warm_teasing",
        "nativeEmotion": null,
        "nativeEmotionScale": null,
        "energy": 0.64,
        "pace": 1.0,
        "volume": 0.96,
        "pitchSemitones": 0,
        "emphasis": "normal",
        "distance": "near",
        "space": "quiet biology room",
        "pauseBeforeMs": 0,
        "pauseAfterMs": 0,
        "breath": "natural",
        "nativeContextTexts": [
          "阳光开朗的少年，正开心地和喜欢的女同学聊天。声音明亮，有明显笑意，语调活泼，亲切自然。忍着笑开玩笑：“你先保证”轻快认真，“不把我泡进罐子里”是故意逗她，不是真的害怕。"
        ],
        "nativeSpeechRate": 5
      }
    },
    {
      "entry": 6,
      "character": "QianTangKui",
      "text": "装叶子的。你这么大，放不下。",
      "startTime": 20.2,
      "endTime": 24.3,
      "speechWindow": [
        20.4,
        24
      ],
      "scene": "BiologyRoomScene",
      "shotIds": [
        "entry_6"
      ],
      "previousEntry": 5,
      "nextEntry": 7,
      "intent": "用具体事实接住玩笑",
      "subtext": "可以放松一点",
      "delivery": {
        "tone": "dry_teasing",
        "nativeEmotion": null,
        "nativeEmotionScale": null,
        "energy": 0.38,
        "pace": 1.0,
        "volume": 0.92,
        "pitchSemitones": 0,
        "emphasis": "normal",
        "distance": "medium",
        "space": "quiet biology room",
        "pauseBeforeMs": 0,
        "pauseAfterMs": 0,
        "breath": "natural",
        "nativeContextTexts": [
          "同学刚开玩笑怕你把他泡进标本罐，你顺着他的玩笑随口回一句，说到放不下时自己有一点想笑。"
        ],
        "nativeSpeechRate": 0
      }
    },
    {
      "entry": 7,
      "character": "LeiXiao",
      "text": "擦不掉……那我把它收回去呢？",
      "startTime": 24.5,
      "endTime": 29,
      "speechWindow": [
        24.7,
        28.7
      ],
      "scene": "BiologyRoomScene",
      "shotIds": [
        "entry_7"
      ],
      "previousEntry": 6,
      "nextEntry": 8,
      "intent": "兴致勃勃地提出一个办法",
      "subtext": "想和她一起试试",
      "delivery": {
        "tone": "warm_engaged",
        "nativeEmotion": null,
        "nativeEmotionScale": null,
        "energy": 0.58,
        "pace": 1.0,
        "volume": 0.96,
        "pitchSemitones": 0,
        "emphasis": "normal",
        "distance": "near",
        "space": "quiet biology room",
        "pauseBeforeMs": 0,
        "pauseAfterMs": 0,
        "breath": "natural",
        "nativeContextTexts": [
          "阳光开朗的少年，正开心地和喜欢的女同学聊天。声音明亮，有明显笑意，语调活泼，亲切自然。接住女生刚才的玩笑，边观察边提出一个小主意，有好奇心，后半句问得轻快。只说台词。"
        ],
        "nativeSpeechRate": 5
      }
    },
    {
      "entry": 8,
      "character": "QianTangKui",
      "text": "先松手，别用力。",
