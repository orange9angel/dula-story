        "nativeEmotion": null,
        "nativeEmotionScale": null,
        "energy": 0.55,
        "pace": 1.0,
        "volume": 0.92,
        "pitchSemitones": 0,
        "emphasis": "normal",
        "distance": "medium",
        "space": "quiet biology room",
        "pauseBeforeMs": 0,
        "pauseAfterMs": 0,
        "breath": "natural",
        "nativeContextTexts": [
          "你发现他手上的印子变长了，先短促叫停，看清楚后把自己的发现告诉他。"
        ],
        "nativeSpeechRate": 0
      }
    },
    {
