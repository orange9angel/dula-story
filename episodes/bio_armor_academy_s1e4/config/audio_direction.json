  "dialogue": [
    {
      "entry": 3,
      "character": "LeiXiao",
      "text": "这道印子……你能让它消失吗？",
      "startTime": 6.5,
      "endTime": 11.5,
      "speechWindow": [
        6.7,
        11.2
      ],
      "scene": "BiologyRoomScene",
      "shotIds": [
        "entry_3"
      ],
      "previousEntry": null,
      "nextEntry": 4,
      "intent": "带着信任向她求助",
      "subtext": "想靠近她，也相信她有办法",
      "delivery": {
        "tone": "warm_engaged",
        "nativeEmotion": null,
        "nativeEmotionScale": null,
        "energy": 0.53,
        "pace": 1.0,
        "volume": 0.96,
        "pitchSemitones": 0,
        "emphasis": "normal",
        "distance": "near",
        "space": "quiet biology room",
        "pauseBeforeMs": 0,
        "pauseAfterMs": 0,
        "breath": "natural",
        "nativeContextTexts": [
          "阳光开朗的少年，正开心地和喜欢的女同学聊天。声音明亮，有明显笑意，语调活泼，亲切自然。有精神地向她求助，带好奇和信任，像终于找到能帮自己的同学。"
        ],
        "nativeSpeechRate": 5
      }
    },
    {
      "entry": 4,
      "character": "QianTangKui",
      "text": "先给我看。藏着那只。",
      "startTime": 11.7,
      "endTime": 14.8,
      "speechWindow": [
        11.899999999999999,
        14.5
      ],
      "scene": "BiologyRoomScene",
      "shotIds": [
        "entry_4"
      ],
      "previousEntry": 3,
      "nextEntry": 5,
      "intent": "让他坦白展示受伤的手",
      "subtext": "已经注意到你的遮掩",
      "delivery": {
        "tone": "happy",
        "nativeEmotion": null,
        "nativeEmotionScale": null,
        "energy": 0.38,
        "pace": 1.0,
        "volume": 0.92,
        "pitchSemitones": 0,
        "emphasis": "normal",
        "distance": "medium",
        "space": "quiet biology room",
        "pauseBeforeMs": 0,
        "pauseAfterMs": 0,
        "breath": "natural",
        "nativeContextTexts": [
          "青春校园恋爱喜剧现场对白，清爽自然的女高中生，温柔机灵、含着笑意，和喜欢的男生近距离聊天，不播报、不嗲、不夸张喊叫。看穿他藏手的小动作，亲近地提醒；藏着那只，轻轻点破，有一点笑意。只说台词。"
        ],
        "nativeSpeechRate": 0
      }
    },
    {
      "entry": 5,
      "character": "LeiXiao",
      "text": "你先保证，不把我泡进罐子里。",
      "startTime": 15,
      "endTime": 20,
      "speechWindow": [
        15.2,
        19.7
      ],
      "scene": "BiologyRoomScene",
      "shotIds": [
        "entry_5"
      ],
      "previousEntry": 4,
      "nextEntry": 6,
      "intent": "逗她笑，接住她的直接",
      "subtext": "跟她待在一起很自在",
      "delivery": {
        "tone": "warm_teasing",
        "nativeEmotion": null,
        "nativeEmotionScale": null,
        "energy": 0.64,
        "pace": 1.0,
        "volume": 0.96,
        "pitchSemitones": 0,
        "emphasis": "normal",
        "distance": "near",
        "space": "quiet biology room",
        "pauseBeforeMs": 0,
        "pauseAfterMs": 0,
        "breath": "natural",
        "nativeContextTexts": [
          "阳光开朗的少年，正开心地和喜欢的女同学聊天。声音明亮，有明显笑意，语调活泼，亲切自然。忍着笑开玩笑：“你先保证”轻快认真，“不把我泡进罐子里”是故意逗她，不是真的害怕。"
        ],
        "nativeSpeechRate": 5
      }
    },
    {
      "entry": 6,
      "character": "QianTangKui",
      "text": "装叶子的。你这么大，放不下。",
      "startTime": 20.2,
      "endTime": 24.3,
      "speechWindow": [
        20.4,
        24
      ],
      "scene": "BiologyRoomScene",
      "shotIds": [
        "entry_6"
      ],
      "previousEntry": 5,
      "nextEntry": 7,
      "intent": "用具体事实接住玩笑",
      "subtext": "可以放松一点",
      "delivery": {
        "tone": "happy",
        "nativeEmotion": null,
        "nativeEmotionScale": null,
        "energy": 0.38,
        "pace": 1.0,
        "volume": 0.92,
        "pitchSemitones": 0,
        "emphasis": "normal",
        "distance": "medium",
        "space": "quiet biology room",
        "pauseBeforeMs": 0,
        "pauseAfterMs": 0,
        "breath": "natural",
        "nativeContextTexts": [
          "青春校园恋爱喜剧现场对白，清爽自然的女高中生，温柔机灵、含着笑意，和喜欢的男生近距离聊天，不播报、不嗲、不夸张喊叫。一本正经地接他的玩笑。装叶子的，淡定；你这么大，放不下，忍住笑轻轻补刀，不嘲讽。只说台词。"
        ],
        "nativeSpeechRate": 0
      }
    },
    {
      "entry": 7,
      "character": "LeiXiao",
      "text": "擦不掉……那我把它收回去呢？",
