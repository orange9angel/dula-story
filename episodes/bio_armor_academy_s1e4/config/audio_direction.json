        "breath": "natural",
        "nativeEmotion": "calm"
      }
    },
    {
      "entry": 16,
      "character": "QianTangKui",
      "text": "放心。你比叶子难养。",
      "startTime": 69,
      "endTime": 73.8,
      "scene": "BiologyRoomScene",
      "shotIds": [],
      "previousEntry": 15,
      "nextEntry": null,
