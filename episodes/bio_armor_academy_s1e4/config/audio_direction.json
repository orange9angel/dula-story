        "distance": "medium",
        "space": "quiet biology room",
        "pauseBeforeMs": 0,
        "pauseAfterMs": 0,
        "breath": "natural",
        "nativeContextTexts": [
          "你看见同学正使劲攥紧受伤的手，马上轻声提醒他松开，注意力在他的手上。"
        ],
        "nativeSpeechRate": 0
      }
    },
    {
      "entry": 9,
      "character": "LeiXiao",
      "text": "就一下——怎么还长了？",
      "startTime": 32,
      "endTime": 35.8,
