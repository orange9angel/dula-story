      ],
      "previousEntry": 7,
      "nextEntry": 9,
      "intent": "发现危险及时提醒",
      "subtext": "不要再强迫身体",
      "delivery": {
        "tone": "concerned",
        "nativeEmotion": null,
        "nativeEmotionScale": null,
        "energy": 0.55,
        "pace": 1.0,
        "volume": 0.92,
        "pitchSemitones": 0,
