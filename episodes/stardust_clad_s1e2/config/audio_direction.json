  "dialogue": [
    {
      "entry": 3,
      "id": "n01",
      "character": "Xiaozao",
      "text": "再擦，盾上那点金漆就没了。",
      "startTime": 15.0,
      "endTime": 21.95,
      "scene": "StardustShrineScene",
      "intent": "深夜在朋友身旁坐着，轻声打趣，关心藏在玩笑里。",
      "subtext": "担心朋友一味责备自己，先用玩笑打开话题。",
      "delivery": {
        "energy": 0.42,
        "pace": 0.97,
        "volume": 1.0,
        "pitchSemitones": 0.0,
        "emphasis": "normal",
        "distance": "near",
        "space": "stone-courtyard",
        "breath": "natural"
      },
      "nativeDelivery": {
        "rate": -3,
        "context": "深夜在朋友身旁坐着，轻声打趣，关心藏在玩笑里。"
      }
    },
    {
      "entry": 4,
      "id": "n02",
      "character": "Aoao",
      "text": "金漆掉了能补。明晚要是又挡不住呢？",
      "startTime": 22.0,
      "endTime": 30.95,
      "scene": "StardustShrineScene",
      "intent": "低声答话，手还在擦盾；后半句终于露出白天留下的担忧。",
      "subtext": "害怕下一次保护不了同伴。",
      "delivery": {
        "energy": 0.42,
        "pace": 0.97,
        "volume": 1.0,
        "pitchSemitones": 0.0,
        "emphasis": "normal",
        "distance": "near",
        "space": "stone-courtyard",
        "breath": "natural"
      },
      "nativeDelivery": {
        "rate": -3,
        "context": "低声答话，手还在擦盾；后半句终于露出白天留下的担忧。"
      }
    },
    {
      "entry": 5,
      "id": "n03",
      "character": "Xiaozao",
      "text": "今天那一击，你挡住了。",
      "startTime": 31.0,
      "endTime": 36.95,
      "scene": "StardustShrineScene",
      "intent": "平静而确切，提醒朋友一个事实，不是安慰小孩。",
      "subtext": "希望他承认自己也做到了。",
      "delivery": {
        "energy": 0.42,
        "pace": 0.97,
        "volume": 1.0,
        "pitchSemitones": 0.0,
        "emphasis": "normal",
        "distance": "near",
        "space": "stone-courtyard",
        "breath": "natural"
      },
      "nativeDelivery": {
        "rate": -3,
        "context": "平静而确切，提醒朋友一个事实，不是安慰小孩。"
      }
    },
    {
      "entry": 6,
      "id": "n04",
      "character": "Aoao",
      "text": "是你们替我补上的。",
      "startTime": 37.0,
      "endTime": 47.95,
      "scene": "StardustShrineScene",
      "intent": "停下手里的活，声音低下来，有些过意不去。",
      "subtext": "不敢把同伴的付出算成自己的胜利。",
      "delivery": {
        "energy": 0.42,
        "pace": 0.97,
        "volume": 1.0,
        "pitchSemitones": 0.0,
        "emphasis": "normal",
        "distance": "near",
        "space": "stone-courtyard",
        "breath": "natural"
      },
      "nativeDelivery": {
        "rate": -3,
        "context": "停下手里的活，声音低下来，有些过意不去。"
      }
    },
    {
      "entry": 7,
      "id": "n05",
      "character": "Xiaozao",
      "text": "所以，你打算一夜不睡，把自己练成三个人？",
      "startTime": 48.0,
      "endTime": 55.95,
      "scene": "StardustShrineScene",
      "intent": "朋友间轻轻反问，前半调侃，最后认真等他回答。",
      "subtext": "用荒唐的办法反问他不肯分担的习惯。",
      "delivery": {
        "energy": 0.42,
        "pace": 0.97,
        "volume": 1.0,
        "pitchSemitones": 0.0,
        "emphasis": "normal",
        "distance": "near",
        "space": "stone-courtyard",
        "breath": "natural"
      },
      "nativeDelivery": {
        "rate": -3,
        "context": "朋友间轻轻反问，前半调侃，最后认真等他回答。"
      }
    },
    {
      "entry": 8,
      "id": "n06",
      "character": "Aoao",
      "text": "至少下回，别让你们替我挨打。",
      "startTime": 56.0,
      "endTime": 64.95,
      "scene": "StardustShrineScene",
      "intent": "对身旁朋友坦白，克制地咬住后半句，不喊口号。",
      "subtext": "把受伤都归到自己的责任。",
      "delivery": {
        "energy": 0.42,
        "pace": 0.97,
        "volume": 1.0,
        "pitchSemitones": 0.0,
        "emphasis": "normal",
        "distance": "near",
        "space": "stone-courtyard",
        "breath": "natural"
      },
      "nativeDelivery": {
        "rate": -3,
        "context": "对身旁朋友坦白，克制地咬住后半句，不喊口号。"
      }
    },
    {
      "entry": 9,
      "id": "n07",
      "character": "Xiaozao",
      "text": "你老这样，轮到我怕的时候，找谁？",
      "startTime": 65.0,
      "endTime": 77.95,
      "scene": "StardustShrineScene",
      "intent": "这次没有开玩笑，语速稍慢，提出自己也会害怕。",
      "subtext": "我也需要你，不能永远被你挡在外面。",
      "delivery": {
        "energy": 0.42,
        "pace": 0.97,
        "volume": 1.0,
        "pitchSemitones": 0.0,
        "emphasis": "normal",
        "distance": "near",
        "space": "stone-courtyard",
        "breath": "natural"
      },
      "nativeDelivery": {
        "rate": -3,
        "context": "这次没有开玩笑，语速稍慢，提出自己也会害怕。"
      }
    },
    {
      "entry": 10,
      "id": "n08",
      "character": "Aoao",
      "text": "那就叫我。",
      "startTime": 78.0,
      "endTime": 82.95,
      "scene": "StardustShrineScene",
      "intent": "听懂朋友的意思后抬头，短短一句，认真答应。",
      "subtext": "愿意听见朋友求助。",
      "delivery": {
        "energy": 0.42,
        "pace": 0.97,
        "volume": 1.0,
        "pitchSemitones": 0.0,
        "emphasis": "normal",
        "distance": "near",
        "space": "stone-courtyard",
        "breath": "natural"
      },
      "nativeDelivery": {
        "rate": -3,
        "context": "听懂朋友的意思后抬头，短短一句，认真答应。"
      }
    },
    {
      "entry": 11,
      "id": "n09",
      "character": "Xiaozao",
      "text": "那你也得叫我们。",
      "startTime": 83.0,
      "endTime": 91.95,
      "scene": "StardustShrineScene",
      "intent": "接住朋友的承诺，声音轻，但末尾坚定。",
      "subtext": "求助应该是双向的。",
      "delivery": {
        "energy": 0.42,
        "pace": 0.97,
        "volume": 1.0,
        "pitchSemitones": 0.0,
        "emphasis": "normal",
        "distance": "near",
        "space": "stone-courtyard",
        "breath": "natural"
      },
      "nativeDelivery": {
        "rate": -3,
        "context": "接住朋友的承诺，声音轻，但末尾坚定。"
      }
    },
    {
      "entry": 12,
      "id": "n10",
      "character": "Aoao",
      "text": "知道了。你先去睡。",
      "startTime": 92.0,
      "endTime": 99.95,
      "scene": "StardustShrineScene",
      "intent": "终于松一口气，带很轻的笑意，把朋友劝回去。",
      "subtext": "先答应，是否做到留待战斗检验。",
      "delivery": {
        "energy": 0.42,
        "pace": 0.97,
        "volume": 1.0,
        "pitchSemitones": 0.0,
        "emphasis": "normal",
        "distance": "near",
        "space": "stone-courtyard",
        "breath": "natural"
      },
      "nativeDelivery": {
        "rate": -3,
        "context": "终于松一口气，带很轻的笑意，把朋友劝回去。"
      }
    },
    {
      "entry": 14,
      "id": "n11",
      "character": "Aoao",
      "text": "脚步停了。锁链还在响。",
      "startTime": 106.0,
      "endTime": 117.95,
      "scene": "StardustShrineScene",
      "intent": "突然警觉，自言自语压低声音，先听，再判断，不像旁白。",
      "subtext": "在眼下窗口向对方采取行动：突然警觉，自言自语压低声音，先听，再判断，不像旁白。",
      "delivery": {
        "energy": 0.42,
        "pace": 0.97,
        "volume": 1.0,
        "pitchSemitones": 0.0,
        "emphasis": "normal",
        "distance": "medium",
        "space": "stone-courtyard",
        "breath": "natural"
