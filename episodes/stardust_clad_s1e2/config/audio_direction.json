    },
    {
      "entry": 9,
      "id": "p07",
      "character": "Yekari",
      "text": "刈夜——无声镰弧！",
      "startTime": 51.0,
      "endTime": 55.95,
      "scene": "EmberTierPalaceScene",
      "intent": "出招蓄力后爆发，刈夜稍停，无声镰弧短促有刃感，保持男性人声。",
      "subtext": "用强弱解释被遗弃的旧伤，逼对手只护自己。",
