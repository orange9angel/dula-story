  "dialogue": [
    {
      "entry": 2,
      "id": "p01",
      "character": "Aoao",
      "text": "小凿在风筛宫，大釜在沉汤宫。焰阶宫，我来守。",
      "startTime": 7.0,
      "endTime": 13.95,
      "scene": "EmberTierPalaceScene",
      "intent": "向通信晶石报平安，话语平实，后半句认真。",
      "subtext": "守住街区火路，不再把硬挡当作唯一办法。",
      "delivery": {
        "energy": 0.48,
        "pace": 1.0,
        "volume": 1,
        "pitchSemitones": 0,
        "emphasis": "normal",
        "distance": "medium",
        "space": "stone-palace",
        "breath": "natural"
      },
      "nativeDelivery": {
        "rate": 0,
        "context": "向通信晶石报平安，话语平实，后半句认真。"
      }
    },
    {
      "entry": 3,
      "id": "p02",
      "character": "Aoao",
      "text": "又卡了。下面那条街，还等着开早灶呢。",
      "startTime": 14.0,
      "endTime": 19.95,
      "scene": "EmberTierPalaceScene",
      "intent": "检查闸槽时自言自语，末尾有一点无奈的笑。",
      "subtext": "守住街区火路，不再把硬挡当作唯一办法。",
      "delivery": {
        "energy": 0.48,
        "pace": 1.0,
        "volume": 1,
        "pitchSemitones": 0,
        "emphasis": "normal",
        "distance": "medium",
        "space": "stone-palace",
        "breath": "natural"
      },
      "nativeDelivery": {
        "rate": 0,
        "context": "检查闸槽时自言自语，末尾有一点无奈的笑。"
      }
    },
    {
      "entry": 5,
      "id": "p03",
      "character": "Yekari",
      "text": "别人都有去处。偏偏把你，一个人留在这里。",
      "startTime": 27.0,
      "endTime": 33.95,
      "scene": "EmberTierPalaceScene",
      "intent": "冷静的年轻男性，扫视空殿，带试探，不咆哮。",
      "subtext": "用强弱解释被遗弃的旧伤，逼对手只护自己。",
      "delivery": {
        "energy": 0.48,
        "pace": 0.95,
        "volume": 1,
        "pitchSemitones": 0,
        "emphasis": "normal",
        "distance": "medium",
        "space": "stone-palace",
        "breath": "natural"
      },
      "nativeDelivery": {
        "rate": -5,
        "context": "冷静的年轻男性，扫视空殿，带试探，不咆哮。"
      }
    },
    {
      "entry": 6,
      "id": "p04",
      "character": "Aoao",
      "text": "他们也在守。你要过哪一道门？",
      "startTime": 34.0,
      "endTime": 39.95,
      "scene": "EmberTierPalaceScene",
      "intent": "握盾转向来人，平静纠正，最后坚定。",
      "subtext": "守住街区火路，不再把硬挡当作唯一办法。",
      "delivery": {
        "energy": 0.48,
        "pace": 1.0,
        "volume": 1,
        "pitchSemitones": 0,
        "emphasis": "normal",
        "distance": "medium",
        "space": "stone-palace",
        "breath": "natural"
      },
      "nativeDelivery": {
        "rate": 0,
        "context": "握盾转向来人，平静纠正，最后坚定。"
      }
    },
    {
      "entry": 7,
      "id": "p05",
      "character": "Yekari",
      "text": "把闸心给我。火，得留给守得住它的人。",
      "startTime": 40.0,
      "endTime": 45.95,
      "scene": "EmberTierPalaceScene",
      "intent": "指向引火闸，明确提出要求，音量不大但压迫。",
      "subtext": "用强弱解释被遗弃的旧伤，逼对手只护自己。",
      "delivery": {
        "energy": 0.48,
        "pace": 0.95,
        "volume": 1,
        "pitchSemitones": 0,
        "emphasis": "normal",
        "distance": "medium",
        "space": "stone-palace",
        "breath": "natural"
      },
      "nativeDelivery": {
        "rate": -5,
        "context": "指向引火闸，明确提出要求，音量不大但压迫。"
      }
    },
    {
      "entry": 8,
      "id": "p06",
      "character": "Aoao",
      "text": "闸心走了，下面的人拿什么生火？",
      "startTime": 46.0,
      "endTime": 50.95,
      "scene": "EmberTierPalaceScene",
      "intent": "挡住闸门路线，简短拒绝，不像宣言。",
      "subtext": "守住街区火路，不再把硬挡当作唯一办法。",
      "delivery": {
        "energy": 0.48,
        "pace": 1.0,
        "volume": 1,
        "pitchSemitones": 0,
        "emphasis": "normal",
        "distance": "medium",
        "space": "stone-palace",
        "breath": "natural"
      },
      "nativeDelivery": {
        "rate": 0,
        "context": "挡住闸门路线，简短拒绝，不像宣言。"
