      "scene": "StarfallColonnadeScene",
      "intent": "年轻成年男子，冷静低沉的正常人声；看到旧景般停顿，绝不咆哮。",
      "subtext": "眼前的值夜人让自己想到从前。",
      "delivery": {
        "energy": 0.42,
        "pace": 1.0,
        "volume": 1.0,
        "pitchSemitones": 0.0,
        "emphasis": "normal",
        "distance": "medium",
