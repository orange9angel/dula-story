      "acting": {
        "emotion": "worry",
        "gaze": "enemy",
        "camera": "stage"
      }
    },
    {
      "id": "n12",
      "t": 120.0,
      "end": 123.95,
      "speaker": "yekari",
      "text": "这里，还留着守夜的人。",
      "delivery": {
        "rate": 0,
        "context": "年轻成年男子，冷静低沉的正常人声；看到旧景般停顿，绝不咆哮。"
      },
      "acting": {
        "emotion": "neutral",
        "gaze": "aoao",
        "camera": "stage"
      }
    },
    {
      "id": "n13",
      "t": 125.0,
      "end": 131.95,
      "speaker": "aoao",
      "text": "大釜！小凿！有人闯殿！",
      "delivery": {
        "rate": -3,
        "context": "从广场向身后的同伴呼喊示警，急促清楚。"
