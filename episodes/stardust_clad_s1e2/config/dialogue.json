      "acting": {
        "emotion": "determined",
        "gaze": "enemy",
        "camera": "stage"
      }
    },
    {
      "id": "n14",
      "t": 132.0,
      "end": 136.95,
      "speaker": "dafu",
      "text": "听见了！盾后面，给俺留个位置！",
      "delivery": {
        "rate": 0,
        "context": "赶来助战，粗爽可靠，脚步刚停有一点喘气。"
