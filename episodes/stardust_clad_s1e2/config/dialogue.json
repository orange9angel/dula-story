  "source": "script.story",
  "source_sha256": "443d068516d4a001c5db936872e813c36bf6a3f3dcfab2a19fe67a143b18e954",
  "lines": [
    {
      "id": "p01",
      "t": 7.0,
      "end": 13.95,
      "speaker": "aoao",
      "text": "小凿在风筛宫，大釜在沉汤宫。焰阶宫，我来守。",
      "delivery": {
        "rate": 0,
        "context": "向通信晶石报平安，话语平实，后半句认真。"
      },
      "acting": {
        "emotion": "neutral",
        "gaze": "lamp",
        "camera": "speech"
      }
    },
    {
      "id": "p02",
      "t": 14.0,
      "end": 19.95,
      "speaker": "aoao",
      "text": "又卡了。下面那条街，还等着开早灶呢。",
      "delivery": {
        "rate": 0,
        "context": "检查闸槽时自言自语，末尾有一点无奈的笑。"
      },
      "acting": {
        "emotion": "neutral",
        "gaze": "gate",
        "camera": "stage"
      }
    },
    {
      "id": "p03",
      "t": 27.0,
      "end": 33.95,
      "speaker": "yekari",
      "text": "别人都有去处。偏偏把你，一个人留在这里。",
      "delivery": {
        "rate": -5,
        "context": "冷静的年轻男性，扫视空殿，带试探，不咆哮。"
      },
      "acting": {
        "emotion": "neutral",
        "gaze": "aoao",
        "camera": "speech"
      }
    },
    {
      "id": "p04",
      "t": 34.0,
      "end": 39.95,
      "speaker": "aoao",
      "text": "他们也在守。你要过哪一道门？",
      "delivery": {
        "rate": 0,
        "context": "握盾转向来人，平静纠正，最后坚定。"
      },
      "acting": {
        "emotion": "determined",
        "gaze": "enemy",
        "camera": "speech"
      }
    },
    {
      "id": "p05",
      "t": 40.0,
      "end": 45.95,
      "speaker": "yekari",
      "text": "把闸心给我。火，得留给守得住它的人。",
      "delivery": {
        "rate": -5,
        "context": "指向引火闸，明确提出要求，音量不大但压迫。"
      },
      "acting": {
        "emotion": "neutral",
        "gaze": "gate",
        "camera": "speech"
      }
    },
    {
      "id": "p06",
      "t": 46.0,
      "end": 50.95,
      "speaker": "aoao",
      "text": "闸心走了，下面的人拿什么生火？",
      "delivery": {
        "rate": 0,
        "context": "挡住闸门路线，简短拒绝，不像宣言。"
      },
      "acting": {
        "emotion": "determined",
        "gaze": "enemy",
        "camera": "speech"
      }
    },
    {
      "id": "p07",
      "t": 51.0,
      "end": 55.95,
      "speaker": "yekari",
      "text": "刈夜——无声镰弧！",
      "delivery": {
        "rate": 12,
        "context": "出招蓄力后爆发，刈夜稍停，无声镰弧短促有刃感，保持男性人声。"
      },
      "acting": {
        "emotion": "determined",
        "gaze": "aoao",
        "camera": "stage"
      }
    },
    {
      "id": "p08",
      "t": 65.0,
      "end": 70.95,
      "speaker": "aoao",
      "text": "明明挡住了……扣带怎么断了？",
      "delivery": {
        "rate": 0,
        "context": "盾挡下却腕痛，压住一口气后低声惊讶，手指松开。"
      },
      "acting": {
        "emotion": "pain",
        "gaze": "shield",
        "camera": "speech"
      }
    },
    {
      "id": "p09",
      "t": 71.0,
      "end": 77.95,
      "speaker": "yekari",
      "text": "再抬高一点。你总不能连头也不护。",
      "delivery": {
        "rate": -5,
        "context": "冷淡看着对手握不稳的盾，边说边试探前压。"
      },
      "acting": {
        "emotion": "neutral",
        "gaze": "aoao",
        "camera": "speech"
      }
    },
    {
      "id": "p10",
      "t": 85.0,
      "end": 90.95,
      "speaker": "aoao",
      "text": "两道痕……链响，比刀光晚半拍。",
      "delivery": {
        "rate": 0,
        "context": "看地面两条痕迹，把听到和看到的对上，低声短句。"
      },
      "acting": {
        "emotion": "worry",
        "gaze": "ground",
        "camera": "stage"
      }
    },
    {
      "id": "p11",
      "t": 91.0,
      "end": 97.95,
      "speaker": "yekari",
      "text": "我只要闸心。下面的火路，断了也罢。",
      "delivery": {
        "rate": -5,
        "context": "看出少年在观察，立刻改变目标，逼迫他的选择。"
      },
      "acting": {
        "emotion": "determined",
        "gaze": "gate",
        "camera": "speech"
      }
    },
    {
      "id": "p12",
      "t": 106.0,
      "end": 112.95,
      "speaker": "aoao",
      "text": "第三层也裂了。再硬接，闸就保不住了。",
      "delivery": {
        "rate": -3,
        "context": "跪稳喘气，摸到盾裂，痛但仍观察闸门，压低声音。"
      },
      "acting": {
        "emotion": "pain",
        "gaze": "shield",
        "camera": "speech"
      }
    },
    {
      "id": "p13",
      "t": 113.0,
      "end": 120.95,
      "speaker": "yekari",
      "text": "我也等过援手。灯灭的时候，一个人都没来。",
      "delivery": {
        "rate": -5,
        "context": "勾起旧事，声线放低，最后冷下来，克制悲伤。"
      },
      "acting": {
        "emotion": "sad",
        "gaze": "aoao",
        "camera": "speech"
      }
    },
    {
      "id": "p14",
      "t": 126.0,
      "end": 131.95,
      "speaker": "aoao",
      "text": "导火槽……不只会送火。",
      "delivery": {
        "rate": 0,
        "context": "目光追到导火槽，想起自己修过的结构，轻而清楚。"
      },
      "acting": {
        "emotion": "neutral",
        "gaze": "ground",
        "camera": "stage"
      }
    },
    {
      "id": "p15",
      "t": 132.0,
      "end": 137.95,
      "speaker": "aoao",
      "text": "你没等到的，不能让下面的人再等一遍。",
      "delivery": {
        "rate": 0,
        "context": "站起来直视对手，不否认他的伤，坚定说自己的选择。"
      },
      "acting": {
        "emotion": "determined",
        "gaze": "enemy",
        "camera": "speech"
      }
    },
    {
      "id": "p16",
      "t": 138.0,
      "end": 144.95,
      "speaker": "yekari",
      "text": "那就连你的盾，一起收走！",
      "delivery": {
        "rate": 10,
        "context": "被戳中后收紧语气，重新蓄力，比第一次短而狠。"
      },
      "acting": {
        "emotion": "determined",
        "gaze": "aoao",
        "camera": "stage"
      }
    },
    {
      "id": "p17",
      "t": 155.0,
      "end": 157.95,
      "speaker": "yekari",
      "text": "你把盾放下了？",
      "delivery": {
        "rate": 0,
        "context": "暗链被嵌在闸槽里，试拉失败，第一次露出惊讶。"
      },
      "acting": {
        "emotion": "surprised",
        "gaze": "chain",
        "camera": "speech"
      }
    },
    {
      "id": "p18",
      "t": 158.0,
      "end": 162.95,
      "speaker": "aoao",
      "text": "烧穿就烧穿。先把火送下去！",
      "delivery": {
        "rate": 0,
        "context": "左腕受伤仍借盾沿压住锁链，短句之后立刻行动。"
      },
      "acting": {
        "emotion": "determined",
        "gaze": "enemy",
        "camera": "speech"
      }
    },
    {
      "id": "p19",
      "t": 163.0,
      "end": 167.95,
      "speaker": "aoao",
      "text": "焰返——灶膛回燃！",
      "delivery": {
        "rate": 12,
        "context": "受伤仍坚定，全力喊招，焰返蓄住，灶膛回燃爆发，尾字干净。"
      },
      "acting": {
        "emotion": "determined",
        "gaze": "enemy",
        "camera": "stage"
      }
    },
    {
      "id": "p20",
      "t": 178.0,
      "end": 183.95,
      "speaker": "yekari",
      "text": "为了那条街，连圣衣都不要了？",
      "delivery": {
        "rate": -3,
        "context": "单膝撑住，刀链断了，难以置信但不求饶，带伤后气息。"
      },
      "acting": {
        "emotion": "pain",
        "gaze": "aoao",
        "camera": "speech"
      }
    },
    {
      "id": "p21",
      "t": 184.0,
      "end": 190.95,
      "speaker": "aoao",
      "text": "甲能补。错过这顿热饭，可补不回来。",
      "delivery": {
        "rate": 0,
        "context": "看着烧黑的臂甲，轻吸气，答得朴素，没有胜利演说。"
      },
      "acting": {
        "emotion": "pain",
        "gaze": "shield",
        "camera": "speech"
      }
    },
    {
      "id": "p22",
      "t": 198.0,
      "end": 204.95,
      "speaker": "aoao",
      "text": "焰阶宫，火路通了。你们守好各自那一盏。",
      "delivery": {
        "rate": 0,
        "context": "向晶石报平安，疲惫却放松，最后半句留一点笑。"
      },
      "acting": {
        "emotion": "neutral",
        "gaze": "lamp",
        "camera": "stage"
      }
    }
  ]
}
