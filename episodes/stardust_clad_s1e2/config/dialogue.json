        "emotion": "happy",
        "gaze": "xiaozao",
        "camera": "speech"
      }
    },
    {
      "id": "n11",
      "t": 106.0,
      "end": 117.95,
      "speaker": "aoao",
      "text": "脚步停了。锁链还在响。",
      "delivery": {
        "rate": -3,
        "context": "突然警觉，自言自语压低声音，先听，再判断，不像旁白。"
