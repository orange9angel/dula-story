[{"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p01.wav", "expect_text": "小凿在风筛宫，大釜在沉汤宫。焰阶宫，我来守。", "window_s": 6.949999999999999, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p02.wav", "expect_text": "又卡了。下面那条街，还等着开早灶呢。", "window_s": 5.949999999999999, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p03.wav", "expect_text": "别人都有去处。偏偏把你，一个人留在这里。", "window_s": 6.950000000000003, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p04.wav", "expect_text": "他们也在守。你要过哪一道门？", "window_s": 5.950000000000003, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p05.wav", "expect_text": "把闸心给我。火，得留给守得住它的人。", "window_s": 5.950000000000003, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p06.wav", "expect_text": "闸心走了，下面的人拿什么生火？", "window_s": 4.950000000000003, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p07.wav", "expect_text": "刈夜——无声镰弧！", "window_s": 4.950000000000003, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p08.wav", "expect_text": "明明挡住了……扣带怎么断了？", "window_s": 5.950000000000003, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p09.wav", "expect_text": "再抬高一点。你总不能连头也不护。", "window_s": 6.950000000000003, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p10.wav", "expect_text": "两道痕……链响，比刀光晚半拍。", "window_s": 5.950000000000003, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p11.wav", "expect_text": "我只要闸心。下面的火路，断了也罢。", "window_s": 6.950000000000003, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p12.wav", "expect_text": "第三层也裂了。再硬接，闸就保不住了。", "window_s": 6.950000000000003, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p13.wav", "expect_text": "我也等过援手。灯灭的时候，一个人都没来。", "window_s": 7.950000000000003, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p14.wav", "expect_text": "导火槽……不只会送火。", "window_s": 5.949999999999989, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p15.wav", "expect_text": "你没等到的，不能让下面的人再等一遍。", "window_s": 5.949999999999989, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p16.wav", "expect_text": "那就连你的盾，一起收走！", "window_s": 6.949999999999989, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p17.wav", "expect_text": "你把盾放下了？", "window_s": 2.9499999999999886, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p18.wav", "expect_text": "烧穿就烧穿。先把火送下去！", "window_s": 4.949999999999989, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p19.wav", "expect_text": "焰返——灶膛回燃！", "window_s": 4.949999999999989, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p20.wav", "expect_text": "为了那条街，连圣衣都不要了？", "window_s": 5.949999999999989, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p21.wav", "expect_text": "甲能补。错过这顿热饭，可补不回来。", "window_s": 6.949999999999989, "kind": "dialogue"}, {"file": "D:\\opensource\\movie\\dula-story\\episodes\\stardust_clad_s1e2\\assets3d\\dialogue\\p22.wav", "expect_text": "焰阶宫，火路通了。你们守好各自那一盏。", "window_s": 6.949999999999989, "kind": "dialogue"}]