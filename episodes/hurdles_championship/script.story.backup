{DiscoWorm}{WormTunnel|duration=2.5}
{Event:Move|character=Zorak|x=-1.83|z=-39.0|duration=2.0|action=Run|frequency=4.2|legLift=high}
{Event:Move|character=Klaw|x=-0.61|z=-39.0|duration=2.0|action=Run|frequency=3.9|legLift=high}
{Event:Move|character=Vex|x=0.61|z=-39.0|duration=2.0|action=Run|frequency=4.0|legLift=high}
{Event:Move|character=Rex|x=1.83|z=-39.0|duration=2.0|action=Run|frequency=3.0|legLift=mid}
{Event:Move|character=DiscoWorm|x=3.05|z=-47.5|duration=2.5|action=WormTunnel}
