[
  {
    "start": 0.0,
    "end": 1.52,
    "text": "Zither Harp"
  },
  {
    "start": 15.86,
    "end": 20.86,
    "text": "雨停了河面泛着光"
  },
  {
    "start": 22.4,
    "end": 28.52,
    "text": "那张画顺着水流向远方"
  },
  {
    "start": 29.9,
    "end": 37.62,
    "text": "画里的你还在微笑吗"
  },
  {
    "start": 37.62,
    "end": 43.44,
    "text": "风把答案吹成了浪"
  },
  {
    "start": 44.56,
    "end": 48.34,
    "text": "我追着岸边的流音"
  },
  {
    "start": 48.34,
    "end": 52.44,
    "text": "换一生回忆轻轻的"
  },
  {
    "start": 52.44,
    "end": 56.34,
    "text": "如果你也听见这方向"
  },
  {
    "start": 56.34,
    "end": 62.24,
    "text": "请把思念折成星光"
  },
  {
    "start": 64.82,
    "end": 68.9,
    "text": "飘吧飘吧带着我的牵挂"
  },
  {
    "start": 68.9,
    "end": 71.72,
    "text": "穿过脚印穿过晚霞"
  },
  {
    "start": 71.72,
    "end": 74.56,
    "text": "某一天你停下"
  },
  {
    "start": 74.56,
    "end": 75.78,
    "text": "那靠岸的地方"
  },
  {
    "start": 75.78,
    "end": 79.04,
    "text": "会有人替我把你收藏"
  },
  {
    "start": 80.56,
    "end": 83.42,
    "text": "飘吧飘吧别把路太长"
  },
  {
    "start": 83.42,
    "end": 86.7,
    "text": "随波里淋着你的模样"
  },
  {
    "start": 87.56,
    "end": 92.58,
    "text": "当春风又吹动我的头发"
  },
  {
    "start": 92.58,
    "end": 100.7,
    "text": "你还会回到身旁"
  },
  {
    "start": 140.14,
    "end": 141.54,
    "text": "Zither Harp"
  }
]