  "lines": [
    {
      "line": 0,
      "text": "雨停了 河面泛着光",
      "start": 15.51,
      "end": 20.75,
      "mean_p": 0.796,
      "transcript": "雨停了河面泛着光",
      "transcript_span": [
        15.86,
        20.86
      ]
    },
    {
      "line": 1,
      "text": "那张画 顺着水流向远方",
      "start": 22.05,
      "end": 28.47,
      "mean_p": 0.852,
      "transcript": "那张画顺着水流向远方",
      "transcript_span": [
        22.4,
        28.52
      ]
    },
    {
      "line": 2,
      "text": "画里的你 还在微笑吗",
      "start": 29.55,
      "end": 37.45,
      "mean_p": 0.838,
      "transcript": "画里的你还在微笑吗",
      "transcript_span": [
        29.9,
        37.62
      ]
    },
    {
      "line": 3,
      "text": "风把答案 吹成了浪",
      "start": 37.27,
      "end": 43.21,
      "mean_p": 0.817,
      "transcript": "风把答案吹成了浪",
      "transcript_span": [
        37.62,
        43.44
      ]
    },
    {
      "line": 4,
      "text": "我追着 岸边的柳影长",
      "start": 44.21,
      "end": 48.69,
      "mean_p": 0.498,
      "transcript": "我追着岸边的流音",
      "transcript_span": [
        44.56,
        48.34
      ]
    },
    {
      "line": 5,
      "text": "唤一声 回音轻轻荡",
      "start": 47.99,
      "end": 52.47,
      "mean_p": 0.404,
      "transcript": "换一生回忆轻轻的",
      "transcript_span": [
        48.34,
        52.44
      ]
    },
    {
      "line": 6,
      "text": "如果你也 听见这方向",
      "start": 52.09,
      "end": 56.23,
      "mean_p": 0.704,
      "transcript": "如果你也听见这方向",
      "transcript_span": [
        52.44,
        56.34
      ]
    },
    {
      "line": 7,
      "text": "请把思念 折成星光",
      "start": 55.99,
      "end": 61.91,
      "mean_p": 0.687,
      "transcript": "请把思念折成星光",
      "transcript_span": [
        56.34,
        62.24
      ]
    },
    {
      "line": 8,
      "text": "漂吧 漂吧 带着我的牵挂",
      "start": 64.47,
      "end": 68.99,
      "mean_p": 0.534,
      "transcript": "飘吧飘吧带着我的牵挂",
      "transcript_span": [
        64.82,
        68.9
      ]
    },
    {
      "line": 9,
      "text": "穿过桥影 穿过晚霞",
      "start": 68.55,
      "end": 71.73,
      "mean_p": 0.626,
      "transcript": "穿过脚印穿过晚霞",
      "transcript_span": [
        68.9,
        71.72
      ]
    },
    {
      "line": 10,
      "text": "某一天 你停下靠岸的地方",
      "start": 71.37,
      "end": 75.95,
      "mean_p": 0.632,
      "transcript": "某一天你停下那靠岸的地方",
      "transcript_span": [
        71.72,
        75.78
      ]
    },
    {
      "line": 11,
      "text": "会有人替我 把你收藏",
      "start": 75.43,
      "end": 78.77,
      "mean_p": 0.752,
      "transcript": "会有人替我把你收藏",
      "transcript_span": [
        75.78,
        79.04
      ]
    },
    {
      "line": 12,
      "text": "漂吧 漂吧 别怕路太长",
      "start": 80.21,
      "end": 83.39,
      "mean_p": 0.636,
      "transcript": "飘吧飘吧别把路太长",
      "transcript_span": [
        80.56,
        83.42
      ]
    },
    {
      "line": 13,
      "text": "碎玻璃里 映着你的模样",
      "start": 83.07,
      "end": 86.25,
      "mean_p": 0.595,
      "transcript": "随波里淋着你的模样",
      "transcript_span": [
        83.42,
        86.7
      ]
    },
    {
      "line": 14,
      "text": "当春风 又吹动我的头发",
      "start": 87.21,
      "end": 92.39,
      "mean_p": 0.592,
      "transcript": "当春风又吹动我的头发",
      "transcript_span": [
        87.56,
        92.58
      ]
    },
    {
      "line": 15,
      "text": "你还会 回到我身旁",
      "start": 92.23,
      "end": 100.07,
      "mean_p": 0.741,
      "transcript": "你还会回到身旁",
      "transcript_span": [
        92.58,
        100.7
      ]
    }
  ],
