{
  "$schema": "../../../../dula-skills/scene-designer/references/scene-contract.schema.json",
  "contractVersion": "1.0",
  "episode": "anime_girl_basketball_5s",
  "sourceStory": "script.story",
  "intent": {
    "premise": "A thirty-second two-character school-gym challenge built from reaction-cut dialogue plates, energy-gated Chinese viseme cels, generated action in-betweens, Foley, subtitles, and a three-part semantic score.",
    "audience": "Viewers evaluating a compact but complete 2D anime short with stable generated characters, readable sports motion, and synchronized sound.",
    "designPriorities": [
      "Keep Higurashi's face, teal ponytail, two hair clips, number 07 uniform, proportions, and screen direction stable across the original and newly generated frames.",
      "Keep the boy's black hair, blue eyes, five-button navy gakuran, white indoor shoes, and charcoal school bag stable from entrance through the closing reaction.",
      "Use hard cuts for all action poses so the ball and limbs never double through a dissolve.",
      "Gate visible closed, half, and open mouth cels at 12 fps from the exact post-trim final dialogue stem, then select limited visemes from the known Chinese syllables, never from subtitle duration.",
      "Derive frame selection, mouth state, crop motion, transitions, and subtitles only from absolute story time so seeks and segmented renders remain deterministic.",
      "Preserve exactly one basketball and clear door, sideline, court, and hoop geography in every applicable shot."
    ]
  },
  "registrations": {
    "bootstrap": "bootstrap.js",
    "scenes": ["AnimeBasketballSequenceScene"],
    "characters": ["Higurashi", "Boy"]
  },
  "scenes": [
    {
      "registryName": "AnimeBasketballSequenceScene",
      "implementation": {
        "kind": "episode-local",
        "name": "AnimeBasketballSequenceScene",
        "module": "scenes/AnimeBasketballSequenceScene.js",
        "export": "AnimeBasketballSequenceScene",
        "bootstrap": "bootstrap.js",
        "readiness": "readyPromise"
      },
      "intent": {
        "location": "A warm late-afternoon Japanese high-school basketball gym with a readable side door, corridor, sideline, court, and rear-left hoop, all baked into full-frame 2D artwork.",
        "timeOfDay": "Late afternoon progressing toward warmer sunset light in the final doorway shots.",
        "tone": ["playful", "athletic", "warm", "lightly competitive"],
        "storyFunction": "Establish Higurashi's last-shot ritual, introduce a uniformed boy through the gym door, escalate their banter into a short one-on-one play, and end on his amused resignation after she scores.",
        "visualRules": [
          "Every source PNG fills the 1920 by 1080 presentation canvas without aspect-ratio distortion.",
          "The keyframe timeline, rather than equal frame division, determines every image boundary and camera-like crop move.",
          "Each spoken line keeps one stable speaker plate; only a tight mouth rectangle changes between closed, half, and open states.",
          "Action coverage uses generated in-between poses and hard cuts at sub-second cadence while SFX timestamps land on the matching ball or foot contact.",
          "Chinese subtitles are rendered in code over text-free source art and must remain inside the lower safe area.",
          "The scene uses a CanvasTexture as the Three.js background, so runtime camera collision geometry is intentionally inapplicable and camera obstacles remain empty.",
          "Higurashi and Boy are voice-only story speakers whose visible bodies are baked into the keyframes; no 3D character meshes may be layered over the artwork."
        ]
      },
      "coordinates": {
        "unit": "meter",
        "upAxis": "+Y",
        "horizontalAxes": ["X", "Z"],
        "groundY": 0
      },
      "stage": {
        "bounds": {"min": [-8, -4.5, -1], "max": [8, 4.5, 1]},
        "zones": [
          {
            "id": "presentationZone",
            "bounds": {"min": [-8, -4.5, -1], "max": [8, 4.5, 1]},
            "walkable": false,
            "purpose": ["Represent the full-frame timed 2D presentation rather than a navigable 3D stage."]
          }
        ],
        "anchors": {
          "screenCenter": {
            "space": "world",
            "relativeTo": "$scene",
            "position": [0, 0, 0],
            "purpose": "Stable center of the full-frame keyframe canvas."
          },
          "bakedSideDoor": {
            "space": "world",
            "relativeTo": "$scene",
            "position": [6, 0, 0],
            "purpose": "Semantic screen-right entrance represented inside the generated artwork."
          },
          "bakedHoop": {
            "space": "world",
            "relativeTo": "$scene",
            "position": [-4, 2.8, 0],
            "purpose": "Semantic rear-left basket represented inside the generated artwork."
          }
        }
      },
      "lighting": {
        "mood": "Warm cel-animated late-afternoon sunlight with a gentle sunset lift for the closing doorway beat.",
        "readabilityRules": [
          "Do not apply runtime lighting or grading that changes character colors between generated frames.",
          "Keep faces, the navy and white costume silhouettes, the orange ball, the open doorway, and the hoop readable during all crop motion and transitions.",
          "Keep subtitle contrast independent of the baked background by using a dark translucent backing and outlined white text."
        ]
      },
      "cameraObstacles": [],
      "audioAnchors": [
        {
          "id": "sideDoorSound",
          "kind": "point",
          "semantic": "School gym side-door latch and hinge opening from screen right.",
          "position": [6, 1, 0],
          "radius": 2.5,
          "loop": false
        },
        {
          "id": "courtFoley",
          "kind": "region",
          "semantic": "Basketball impacts and indoor-shoe squeaks across the painted court.",
          "position": [0, 0, 0],
          "radius": 7,
