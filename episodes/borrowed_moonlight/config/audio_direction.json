   "endTime": 162.0,
   "scene": "ClockTowerScene",
   "shotIds": [
    "m21"
   ],
   "previousEntry": 19,
   "nextEntry": 22,
   "intent": "惊喜，压低声音的欢呼。（压低声音的欢呼",
