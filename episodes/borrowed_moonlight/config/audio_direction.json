   "endTime": 140.0,
   "scene": "ClockTowerScene",
   "shotIds": [
    "m18"
   ],
   "previousEntry": 16,
   "nextEntry": 19,
   "intent": "继续追问",
   "subtext": "她不接受大人们的\"没办法\"",
   "delivery": {
    "tone": "curious",
    "energy": 0.55,
    "pace": 1.0,
    "volume": 1.0,
    "pitchSemitones": 0.0,
    "emphasis": "normal",
    "distance": "medium",
    "space": "room",
    "pauseBeforeMs": 0,
    "pauseAfterMs": 0,
    "breath": "natural"
   }
  },
  {
   "entry": 19,
   "character": "Alder",
   "text": "因为有些人，已经不愿意再打开自己的心了。",
   "startTime": 140.0,
   "endTime": 149.0,
   "scene": "ClockTowerScene",
   "shotIds": [
    "m19"
   ],
   "previousEntry": 18,
   "nextEntry": 21,
   "intent": "回避，声音更低。（回避，声音更低",
   "subtext": "说的是镇上人，也是他自己和女儿",
   "delivery": {
    "tone": "sad",
    "energy": 0.36,
    "pace": 0.92,
    "volume": 1.0,
    "pitchSemitones": 0.0,
    "emphasis": "soft",
    "distance": "medium",
    "space": "room",
    "pauseBeforeMs": 0,
    "pauseAfterMs": 0,
    "breath": "natural"
   }
  },
  {
   "entry": 21,
   "character": "Eileen",
   "text": "您看！它醒了！",
