   "endTime": 126.0,
   "scene": "ClockTowerScene",
   "shotIds": [
    "m16"
   ],
   "previousEntry": 15,
   "nextEntry": 18,
   "intent": "沙哑缓慢，平静里有旧伤。（平静里有旧伤",
   "subtext": "他把自己也算进\"忘记怎么发光\"的人里",
   "delivery": {
    "tone": "neutral",
    "energy": 0.4,
    "pace": 0.92,
    "volume": 1.0,
    "pitchSemitones": 0.0,
    "emphasis": "normal",
    "distance": "medium",
    "space": "room",
    "pauseBeforeMs": 0,
    "pauseAfterMs": 0,
    "breath": "natural"
   }
  },
  {
   "entry": 18,
