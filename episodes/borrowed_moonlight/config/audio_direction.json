   "endTime": 117.0,
   "scene": "ClockTowerScene",
   "shotIds": [
    "m15"
   ],
   "previousEntry": 10,
   "nextEntry": 16,
   "intent": "天真的质问，没有指责。（天真的质问",
   "subtext": "孩子的世界里没有\"关起来\"的正当理由，不带指责",
   "delivery": {
    "tone": "curious",
    "energy": 0.55,
    "pace": 1.0,
    "volume": 1.0,
    "pitchSemitones": 0.0,
    "emphasis": "normal",
    "distance": "medium",
    "space": "room",
    "pauseBeforeMs": 0,
    "pauseAfterMs": 0,
    "breath": "natural"
   }
  },
  {
   "entry": 16,
   "character": "Alder",
   "text": "我没有关住它们。是它们的主人，忘记了怎么发光。",
