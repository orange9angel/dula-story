   "endTime": 200.0,
   "scene": "TowerTopScene",
   "shotIds": [
    "m26"
   ],
   "previousEntry": 23,
   "nextEntry": 27,
   "intent": "沉重的宣判，一字一顿。（沉重的宣判，一字一顿",
   "subtext": "他心里其实还想被反驳",
   "delivery": {
    "tone": "sad",
