 "dialogue": [
  {
   "entry": 1,
   "character": "Narrator",
   "text": "很久很久以前，有一个王国，那里一年四季都下着雪。",
   "startTime": 0.0,
   "endTime": 11.0,
   "scene": "SnowTownScene",
   "shotIds": [
    "m01"
   ],
   "previousEntry": null,
   "nextEntry": 2,
   "intent": "很久很久以前的开卷语气，温厚、缓慢。（开卷定调，炉火边缓缓开口",
   "subtext": "讲故事的人珍爱这个故事，想讲给愿意听的人",
   "delivery": {
    "tone": "neutral",
    "energy": 0.42,
    "pace": 0.92,
    "volume": 1.0,
    "pitchSemitones": 0.0,
    "emphasis": "normal",
    "distance": "medium",
    "space": "outdoor",
    "pauseBeforeMs": 0,
    "pauseAfterMs": 0,
    "breath": "natural"
   }
  },
  {
   "entry": 2,
   "character": "Narrator",
   "text": "人们说，那是因为春天在很久以前，迷了路。",
   "startTime": 11.0,
   "endTime": 19.0,
   "scene": "SnowTownScene",
   "shotIds": [
    "m02"
   ],
   "previousEntry": 1,
   "nextEntry": 3,
   "intent": "接着说书，带一点惋惜。（接着铺民间说法",
   "subtext": "惋惜里带一点神秘，为真相留台阶",
   "delivery": {
    "tone": "neutral",
    "energy": 0.42,
    "pace": 0.92,
    "volume": 1.0,
    "pitchSemitones": 0.0,
    "emphasis": "normal",
    "distance": "medium",
    "space": "outdoor",
    "pauseBeforeMs": 0,
    "pauseAfterMs": 0,
    "breath": "natural"
   }
  },
  {
   "entry": 3,
   "character": "Narrator",
   "text": "可真正的原因是……再也没有人记得，春天是什么模样了。",
   "startTime": 19.0,
   "endTime": 27.0,
   "scene": "SnowTownScene",
   "shotIds": [
    "m03"
   ],
   "previousEntry": 2,
   "nextEntry": 5,
   "intent": "揭开真正原因，声音放低。（揭开真正原因",
   "subtext": "遗忘才是全片的题眼，声音放低是把分量放重",
   "delivery": {
    "tone": "sad",
    "energy": 0.38,
    "pace": 0.92,
    "volume": 1.0,
    "pitchSemitones": 0.0,
    "emphasis": "soft",
    "distance": "medium",
    "space": "outdoor",
    "pauseBeforeMs": 0,
    "pauseAfterMs": 0,
    "breath": "natural"
   }
  },
  {
   "entry": 5,
   "character": "Eileen",
   "text": "月亮，你今晚怎么这么暗呀？",
   "startTime": 35.0,
   "endTime": 43.0,
   "scene": "SnowTownScene",
   "shotIds": [
    "m05"
   ],
   "previousEntry": 3,
   "nextEntry": 6,
   "intent": "轻声，天真的关切。（天真地关切月亮",
   "subtext": "她把自己的孤独投射到月亮身上",
   "delivery": {
    "tone": "curious",
    "energy": 0.5,
    "pace": 1.0,
    "volume": 1.0,
    "pitchSemitones": 0.0,
    "emphasis": "normal",
    "distance": "intimate",
    "space": "outdoor",
    "pauseBeforeMs": 0,
    "pauseAfterMs": 0,
    "breath": "natural"
   }
  },
  {
   "entry": 6,
   "character": "Eileen",
   "text": "是不是，也没有人陪你说话？",
   "startTime": 43.0,
   "endTime": 51.0,
   "scene": "SnowTownScene",
   "shotIds": [
    "m06"
   ],
   "previousEntry": 5,
   "nextEntry": 9,
   "intent": "压低声音，像怕惊动谁。（压低声音共情",
   "subtext": "说的是月亮，也是她自己",
   "delivery": {
    "tone": "sad",
    "energy": 0.4,
    "pace": 1.0,
    "volume": 1.0,
    "pitchSemitones": 0.0,
    "emphasis": "soft",
    "distance": "intimate",
    "space": "outdoor",
    "pauseBeforeMs": 0,
    "pauseAfterMs": 0,
    "breath": "natural"
   }
  },
  {
   "entry": 9,
   "character": "Eileen",
   "text": "别怕。",
   "startTime": 63.0,
   "endTime": 70.0,
   "scene": "SnowTownScene",
   "shotIds": [
    "m09"
   ],
   "previousEntry": 6,
   "nextEntry": 10,
   "intent": "安慰灯，也像安慰自己。（安慰灯",
   "subtext": "也在安慰自己——她熟悉害怕的滋味",
   "delivery": {
    "tone": "gentle",
    "energy": 0.38,
    "pace": 1.0,
    "volume": 1.0,
    "pitchSemitones": 0.0,
    "emphasis": "soft",
    "distance": "intimate",
    "space": "outdoor",
    "pauseBeforeMs": 0,
    "pauseAfterMs": 0,
    "breath": "natural"
   }
  },
  {
   "entry": 10,
   "character": "Eileen",
   "text": "我也常常一个人。",
   "startTime": 70.0,
   "endTime": 78.0,
   "scene": "SnowTownScene",
   "shotIds": [
    "m10"
   ],
   "previousEntry": 9,
   "nextEntry": 15,
   "intent": "坦白自己的小秘密，轻而稳。（坦白自己的小秘密",
   "subtext": "信任月亮才说得出口",
   "delivery": {
    "tone": "sad",
    "energy": 0.4,
    "pace": 0.97,
    "volume": 1.0,
    "pitchSemitones": 0.0,
    "emphasis": "soft",
    "distance": "intimate",
    "space": "outdoor",
    "pauseBeforeMs": 0,
    "pauseAfterMs": 0,
    "breath": "natural"
   }
  },
  {
   "entry": 15,
   "character": "Eileen",
   "text": "先生，您为什么把星星关在瓶子里？",
