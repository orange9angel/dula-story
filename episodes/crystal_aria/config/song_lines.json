[{"cue":"l01","text":"你不必把沉默解释清楚","start":13.3,"end":16.7},
 {"cue":"l02","text":"也不必证明伤口曾经痛","start":16.7,"end":20.04},
 {"cue":"l03","text":"把手放在这里听一听","start":20.04,"end":23.62},
 {"cue":"l04","text":"两颗心能唱同一种风","start":23.62,"end":27.5},
 {"cue":"l05","text":"咚是我的木头心","start":27.5,"end":30.95},
 {"cue":"l06","text":"嗒是你落下的音","start":30.95,"end":33.66},
 {"cue":"l07","text":"走错拍也没有关系","start":33.66,"end":36.82},
 {"cue":"l08","text":"我会等你再数一二三","start":36.82,"end":40.42},
 {"cue":"l09","text":"借我一小段旋律","start":40.42,"end":44.45},
 {"cue":"l10","text":"哪怕只有一声呼吸","start":44.45,"end":49.2},
 {"cue":"l11","text":"你听我们已经在一起","start":50.7,"end":58.0}]
