 "subtitles": [
  {
   "character": "LeiXiao",
   "text": "放学后走这边……应该，能躲开他吧。",
   "start": 7.45,
   "end": 13.014,
   "kind": "dialogue"
  },
  {
   "character": "HongGang",
   "text": "雷晓！拳斗部轰刚！把你手臂里那东西赌上，跟我打一场！",
   "start": 16.214000000000002,
   "end": 22.25,
   "kind": "dialogue"
  },
  {
   "character": "LeiXiao",
   "text": "我、我不会打架……这东西也不是我想要的！",
   "start": 22.6,
   "end": 29.13,
   "kind": "dialogue"
  },
  {
   "character": "HongGang",
   "text": "社团战的规矩——输的人，交出碎片。少废话，碎岩，上身！",
   "start": 29.48,
   "end": 36.139,
   "kind": "dialogue"
  },
  {
   "character": "LeiXiao",
   "text": "又是……它自己动的？！",
   "start": 40.138999999999996,
   "end": 43.828,
   "kind": "dialogue"
  },
  {
   "character": "LeiXiao",
   "text": "不是它……是我！右臂——听我一次！",
   "start": 48.428,
   "end": 55.317,
   "kind": "dialogue"
  },
  {
   "character": "HongGang",
   "text": "哈！好拳！碎片，你留着。下次，我不会输。",
   "start": 55.666999999999994,
   "end": 60.887,
   "kind": "dialogue"
  },
  {
   "character": "LeiXiao",
   "text": "这是什么……",
   "start": 61.236999999999995,
   "end": 63.186,
   "kind": "dialogue"
  }
 ]
