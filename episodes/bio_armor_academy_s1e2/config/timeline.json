 "subtitles": [
  {
   "character": "LeiXiao",
   "text": "放学后走这边……应该，能躲开他吧。",
   "start": 7.45,
   "end": 11.662999999999998,
   "kind": "dialogue"
  },
  {
   "character": "HongGang",
   "text": "雷晓！拳斗部轰刚！把你手臂里那东西赌上，跟我打一场！",
   "start": 14.863000000000001,
   "end": 20.73,
   "kind": "dialogue"
  },
  {
   "character": "LeiXiao",
   "text": "我、我不会打架……这东西也不是我想要的！",
   "start": 21.080000000000002,
   "end": 26.320999999999998,
   "kind": "dialogue"
  },
  {
   "character": "HongGang",
   "text": "社团战的规矩——输的人，交出碎片。少废话，碎岩，上身！",
   "start": 26.671,
   "end": 34.557,
   "kind": "dialogue"
  },
  {
   "character": "LeiXiao",
   "text": "又是……它自己动的？！",
   "start": 38.556999999999995,
   "end": 41.124,
   "kind": "dialogue"
  },
  {
   "character": "LeiXiao",
   "text": "不是它……是我！右臂——听我一次！",
   "start": 45.724,
   "end": 51.104000000000006,
   "kind": "dialogue"
  },
  {
   "character": "HongGang",
   "text": "哈哈……好拳！碎片你留着。下次，我不会输。",
   "start": 51.454,
   "end": 57.082,
   "kind": "dialogue"
  },
  {
   "character": "LeiXiao",
   "text": "这是什么……",
   "start": 57.431999999999995,
   "end": 59.382000000000005,
   "kind": "dialogue"
  }
 ]
