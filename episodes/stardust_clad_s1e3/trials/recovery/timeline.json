{
  "duration": 26.0,
  "source_sha256": "1dbc9149bd18b04f544da6847afd5ab31f8ff082dcf7a5b32b6e36207437c4dc",
  "beats": [
    {
      "id": "space",
      "visual": "风筛宫桥头石廊。小凿举筛盘护住通路，缄网右手张开，银索悬在两人之间。交代完整圣衣、距离与攻击方向。",
      "start": 0.0,
      "end": 2.45
    },
    {
      "id": "warning",
      "visual": "缄网盯着对手的手腕，食指慢慢收紧，先勒索再出手。",
      "start": 2.5,
      "end": 5.75
    },
    {
      "id": "attack",
      "visual": "缄网先沉髋、扬臂，再斜抽银索；小凿抬盘挡下，却被银索绕住。肩胸受力后撤，后脚压实。",
      "start": 5.8,
      "end": 8.55
    },
    {
      "id": "read",
      "visual": "缄网继续收指拉索，小凿疼得闭眼半拍；睁眼先看缠盘银索，再看缺口刮起的一根细丝。镜头看见银索尚未断，腕部仍被勒住。",
      "start": 8.6,
      "end": 11.45
    },
    {
      "id": "yield",
      "visual": "小凿不再向外挣，前送半步卸力，让勒腕的银索滑入筛盘边缘缺口，再转腕卡住。索力转到盘与护臂上，腕部松开，仍因疼痛咬紧嘴；缄网收紧手指、前压追索。",
      "start": 11.5,
      "end": 14.55
    },
    {
      "id": "reverse",
      "visual": "小凿咬牙，以卡住索的筛盘承力，向后蹬地，髋胸先后拧转反拉。缄网先被手腕带偏，肩胸随后前倾；他立即用左手夺索、调整支撑，压着动作质问，不停手等回答。",
      "start": 14.6,
      "end": 18.45
    },
    {
      "id": "cut",
      "visual": "缄网左手持续夺索，将缺口里已经起丝的索段绷紧；小凿抓住这一瞬，以缺口锐边转切。银索断端回弹，对手失衡后踏实收住。",
      "start": 18.5,
      "end": 21.45
    },
    {
      "id": "aftermath",
      "visual": "小凿没有追击，压住仍疼的腕部重新护住通路；缄网看一眼断索，抬眼重新审视对手。断索留在石地上。",
      "start": 21.5,
      "end": 26.0
    }
  ],
  "lines": [
    {
      "id": "l05",
      "speaker": "jianwang",
      "text": "越想挣开，越疼。",
      "start": 2.5,
      "end": 5.75,
      "t": 2.58,
      "audio_end": 4.67
    },
    {
      "id": "e01",
      "speaker": "xiaozao",
      "text": "喝！",
      "start": 5.8,
      "end": 8.55,
      "t": 6.71,
      "audio_end": 6.93
    },
    {
      "id": "l13",
      "speaker": "jianwang",
      "text": "你故意接住那根索？",
      "start": 14.6,
      "end": 18.45,
      "t": 14.68,
      "audio_end": 15.925
    },
    {
