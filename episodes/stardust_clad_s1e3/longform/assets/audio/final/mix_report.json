  "mixPeak": 0.6550987958908081,
  "stemSumMaxError": 3.5762786865234375e-07,
  "voicedTenSecondSNRMedianDB": 18.603105387472603,
  "voicedTenSecondSNRMinimumDB": 4.1216485836169365,
  "perLineVoicedSNRMedianDB": 18.235015581752485,
  "lowestVoicedLineSNR": [
    {
      "id": "B19_01",
      "start": 1060.396,
      "text": "趴下！别站在玻璃下面！",
      "tone": "danger",
      "snrDB": 8.308798330286006
    },
    {
      "id": "B39_03",
      "start": 2123.993,
      "text": "接住。只借你这一次。",
      "tone": "finale",
      "snrDB": 8.53030677647977
    },
    {
      "id": "B36_05",
      "start": 2004.536,
      "text": "那盘撑不过十息。",
      "tone": "finale",
      "snrDB": 10.684429044697293
    },
    {
      "id": "B30_01",
      "start": 1732.666,
      "text": "缺了一个孔，你就少一个方向。",
      "tone": "danger",
      "snrDB": 11.30105423802084
    },
    {
      "id": "B29_05",
      "start": 1707.496,
      "text": "弥灯，走！别回头数他打了几拳！",
      "tone": "danger",
      "snrDB": 11.539676543207563
    },
    {
      "id": "B39_05",
      "start": 2134.528,
      "text": "手握紧一点，你们两个的嘴都比手硬。",
      "tone": "finale",
      "snrDB": 11.725488626764044
    },
    {
      "id": "B14_08",
      "start": 685.342,
      "text": "人在怕的时候，错得更多。",
      "tone": "danger",
      "snrDB": 11.727583855190709
    },
    {
      "id": "B37_01",
      "start": 2032.921,
      "text": "我只是换一个支点。风种还是我的。",
      "tone": "finale",
      "snrDB": 11.751501359203036
    },
    {
      "id": "B19_02",
      "start": 1062.611,
      "text": "那片风叶把热风放出来了，可底闸没开，它只能往暖管里挤！",
      "tone": "danger",
      "snrDB": 11.87093972278696
    },
    {
      "id": "B06_05",
      "start": 274.266,
      "text": "……只移到梁上。不许碰我的线。",
      "tone": "dispute",
      "snrDB": 11.975745668990765
    },
    {
      "id": "B39_01",
      "start": 2119.368,
      "text": "我松手，不是认输。",
      "tone": "finale",
      "snrDB": 11.999907630128174
    },
    {
      "id": "B38_04",
      "start": 2082.499,
      "text": "我来这里，不是帮你们修桥的！",
      "tone": "dispute",
      "snrDB": 12.031207880348756
    },
    {
      "id": "B43_01",
      "start": 2365.793,
      "text": "现在是四拍。真的是四拍。",
      "tone": "home",
      "snrDB": 12.050017092193341
    },
    {
      "id": "B40_03",
      "start": 2174.933,
      "text": "开了半尺，还差一点！",
      "tone": "finale",
      "snrDB": 12.26396962623613
    },
    {
      "id": "B18_05",
      "start": 1035.631,
      "text": "喝！",
      "tone": "danger",
      "snrDB": 12.29099145525469
    },
    {
      "id": "B42_07",
      "start": 2331.099,
      "text": "哈！",
      "tone": "finale",
      "snrDB": 12.438054621571041
    },
    {
      "id": "B38_05",
      "start": 2090.974,
      "text": "那你也别让这座桥变成你的坟。",
      "tone": "dispute",
      "snrDB": 12.451300907628404
    },
    {
      "id": "B14_06",
      "start": 679.602,
      "text": "这座宫教给你的办法，也会错。",
      "tone": "danger",
      "snrDB": 12.508447154741244
    },
    {
      "id": "B32_08",
      "start": 1859.591,
      "text": "小凿，你得把他那只手带过来！",
      "tone": "danger",
      "snrDB": 12.570098332360335
    },
    {
      "id": "B42_08",
      "start": 2332.533,
      "text": "托住了！往上，别管我！",
      "tone": "finale",
      "snrDB": 12.60846392397648
    }
  ],
