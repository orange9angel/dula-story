  "source": "script.story",
  "source_sha256": "6fac11dbdf1e7138964f058f455cb31bbfde4793e7ea15b91f04090820726c08",
  "lines": [
    {
      "id": "l01",
      "t": 6.0,
      "end": 9.95,
      "speaker": "weihe",
      "text": "再等，药就凉了。",
      "delivery": {
        "rate": 0,
        "context": "年轻送药人隔着风声压住焦急，药箱牢牢抱在胸前。"
      },
      "acting": {}
    },
    {
      "id": "l02",
      "t": 10.0,
      "end": 14.95,
      "speaker": "xiaozao",
      "text": "再等一次。我要看准。一，二……",
      "delivery": {
        "rate": -5,
        "context": "冷静少年观察桥索而非故作高冷，轻声阻止同伴迈步，数到二时停住。"
      },
      "acting": {}
    },
    {
      "id": "l03",
      "t": 21.0,
      "end": 25.95,
      "speaker": "jianwang",
      "text": "现在不晃了。你们应该谢我。",
      "delivery": {
        "rate": -8,
        "context": "成熟男声非常轻，像替别人做好决定，控制欲藏在温和里，不用咆哮。"
      },
      "acting": {}
    },
    {
      "id": "l04",
      "t": 30.0,
      "end": 33.95,
      "speaker": "xiaozao",
      "text": "别动。它在听桥板。",
      "delivery": {
        "rate": 0,
        "context": "手腕突然被勒住，短促吸气后把提醒压低，目光移到对方脚下。"
      },
      "acting": {}
    },
    {
      "id": "l05",
      "t": 34.0,
      "end": 38.95,
      "speaker": "jianwang",
      "text": "越想挣开，越疼。",
      "delivery": {
        "rate": -5,
        "context": "对少年不自量力轻微失望，语气仍温和。"
      },
      "acting": {}
    },
    {
      "id": "e01",
      "t": 39.0,
      "end": 44.95,
      "speaker": "xiaozao",
      "text": "喝！",
      "delivery": {
        "rate": 0,
        "context": "腹部发力的短促出拳声，随后被绳索牵住，声音只发一次不要朗读动作。"
      },
      "acting": {}
    },
    {
      "id": "l06",
      "t": 45.0,
      "end": 49.95,
      "speaker": "jianwang",
      "text": "我替你们停下来，就没人会掉下去。",
      "delivery": {
        "rate": -8,
        "context": "试图安抚受困者，轻声的怜悯反而显得冷酷。"
      },
      "acting": {}
    },
    {
      "id": "l07",
      "t": 50.0,
      "end": 54.95,
      "speaker": "weihe",
      "text": "小凿！桥……断了！",
      "delivery": {
        "rate": 0,
        "context": "脚下桥板断裂，短促惊叫，后半句咬住牙不让药箱掉下去。"
      },
      "acting": {}
    },
    {
      "id": "l08",
      "t": 60.0,
      "end": 65.95,
      "speaker": "xiaozao",
      "text": "不是风。是你把整座桥拉紧了。",
      "delivery": {
        "rate": -10,
        "context": "少年从憋气转为缓缓呼气，说给自己听，抓住观察到的规律而不是宣布大道理。"
      },
      "acting": {}
    },
    {
      "id": "l09",
      "t": 66.0,
      "end": 71.95,
      "speaker": "weihe",
      "text": "我……还要等吗？",
      "delivery": {
        "rate": 0,
        "context": "悬在桥边的年轻人努力相信对方，声音发抖，却不求饶。"
      },
      "acting": {}
    },
    {
      "id": "l10",
      "t": 72.0,
      "end": 76.95,
      "speaker": "xiaozao",
      "text": "不用。把手给我。",
      "delivery": {
        "rate": -10,
        "context": "很轻很确定，目光先落到对方伸出的手，再抬眼。不要变成英雄宣言。"
      },
      "acting": {}
    },
    {
      "id": "e02",
      "t": 77.0,
      "end": 82.95,
      "speaker": "xiaozao",
      "text": "呃！",
      "delivery": {
        "rate": 0,
        "context": "在用整条腿和背部承受拉力，先吸住气，发一个吃力的短音。"
      },
      "acting": {}
    },
    {
      "id": "l11",
      "t": 83.0,
      "end": 87.95,
      "speaker": "jianwang",
      "text": "筛盘碎了，你拿什么挡？",
      "delivery": {
        "rate": 0,
        "context": "第一次失去从容，质问中有真实恐惧，不是夸张嘲笑。"
      },
      "acting": {}
    },
    {
      "id": "l12",
      "t": 88.0,
      "end": 93.95,
      "speaker": "xiaozao",
      "text": "先让她过去。",
      "delivery": {
        "rate": 0,
        "context": "负重呼吸中给出简短的行动指令，决心不靠提高音量。"
      },
      "acting": {}
    },
    {
      "id": "l13",
      "t": 94.0,
      "end": 98.95,
      "speaker": "jianwang",
      "text": "你故意接住那根索？",
      "delivery": {
        "rate": -5,
        "context": "凝视反向绷紧的操纵弦，发现自己被迫暴露位置，声音变紧。"
      },
      "acting": {}
    },
    {
      "id": "e03",
      "t": 99.0,
      "end": 104.95,
      "speaker": "xiaozao",
      "text": "哈！",
      "delivery": {
        "rate": 0,
        "context": "脚踩实后转髋发力，短促气声爆发，收住尾音。"
      },
      "acting": {}
    },
    {
      "id": "l14",
      "t": 111.0,
      "end": 116.95,
      "speaker": "weihe",
      "text": "你的手还在抖。",
      "delivery": {
        "rate": -6,
        "context": "已经安全，看到对方手臂仍抖，关切但不煽情。"
      },
      "acting": {}
    },
    {
      "id": "l15",
      "t": 117.0,
      "end": 122.95,
      "speaker": "xiaozao",
      "text": "嗯。药还热吗？",
      "delivery": {
        "rate": -8,
        "context": "少年终于承认自己的害怕，轻微气短，有一点自嘲，绝不说教。"
      },
      "acting": {}
    },
    {
      "id": "l16",
      "t": 123.0,
      "end": 128.95,
      "speaker": "weihe",
      "text": "还热。",
      "delivery": {
        "rate": -5,
        "context": "打开箱盖一条缝确认后松口气，温柔而克制。"
      },
      "acting": {}
    }
  ]
}
