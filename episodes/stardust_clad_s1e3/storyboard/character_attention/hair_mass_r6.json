  "misses": [
    {
      "id": "mass-versus-strands",
      "origin": "user_reported",
      "prior_judgment": "Initially interpreted finer appearance too readily as a need for additional thin locks.",
      "later_finding": "The user identified disconnected dark regions and asked for a continuous mass across 3D views.",
      "lesson": "Separate color fragmentation from missing geometry before adding locks; check ears, nape and pitched intermediate angles for overfill and openings.",
      "validation_status": "Applied in this local trial; whole-hair quality remains unaccepted."
    },
    {
      "id": "r5-frontal-overlap",
      "origin": "self_found",
      "prior_judgment": "The static front looked connected.",
      "later_finding": "Ordered R5 turn frames expose frontal skin wedges.",
      "lesson": "A frontal still is not sufficient for internal overlap coverage.",
      "validation_status": "Fixed and rechecked in R6 sampled turns; not an all-angle guarantee."
    }
  ],
  "reviewer_conclusion": "One 3D hair candidate, 12 diagnostic poses and six decoded sequence boards. Connected-color gain with remaining shape and lighting defects. Not reference-level quality."
}
